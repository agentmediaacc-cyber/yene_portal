    <div class="brand"><i class="fa-solid fa-car-side"></i> YENE HUB</div>
    <div class="nav">
      <div class="item active" onclick="showView('v-home', this)"><i class="fa-solid fa-house"></i> Dashboard</div>
      <div class="item" onclick="showView('v-register', this)"><i class="fa-solid fa-user-plus"></i> Register Network</div>
      <div class="item" onclick="showView('v-team', this)"><i class="fa-solid fa-people-group"></i> Team & Rewards</div>
      <div class="item" onclick="showView('v-leaderboard', this)"><i class="fa-solid fa-trophy"></i> Leaderboard</div>
      <div class="item" onclick="showView('v-wallet', this)"><i class="fa-solid fa-wallet"></i> Wallet</div>
      <div class="item" onclick="showView('v-marketing', this)"><i class="fa-solid fa-bullhorn"></i> Marketing</div>
      <div class="item" onclick="showView('v-settings', this)"><i class="fa-solid fa-gear"></i> Settings</div>
    </div>
    <div style="padding:16px;border-top:1px solid var(--line)">
      <div class="row">
        <button class="btn dark" onclick="window.location.href='/'">Return Home</button>
        <button class="btn dark" onclick="loadDashboard()">Refresh</button>
        <button class="btn red" onclick="window.location.href='/logout'">Logout</button>
      </div>
    </div>
  </aside>

  <main class="main">
    <div class="mobile-actions">
      <button class="btn dark" onclick="window.location.href='/'">Home</button>
      <button class="btn dark" onclick="loadDashboard()">Refresh</button>
    </div>

    <div class="sticky-top">
      <div class="topbar">
        <div>
          <div class="sub">YENE AGENT PORTAL
<div style="margin-top:8px;color:#d9e8ff;font-size:14px;">Windhoek • Ocean • Mobile Ready</div></div>
          <h1 class="title" id="welcomeText">Welcome, Agent</h1>
          <div class="sub" id="weekLabel">Week: loading...</div>
        </div>
        <div><span class="pill" id="rankBadge">Starter Agent</span></div>
      </div>
      <div id="statusBox" class="status">Loading dashboard...</div>
    </div>

    <section id="v-home" class="view active">
      <div class="grid">
        <div class="card"><div class="sub">Calculated Earnings This Week</div><div class="metric" id="weeklyEarnings">N$ 0.00</div></div>
        <div class="card"><div class="sub">Drivers Registered This Week</div><div class="metric" id="weeklyDrivers">0</div></div>
        <div class="card"><div class="sub">Clients Registered This Week</div><div class="metric" id="weeklyClients">0</div></div>
        <div class="card"><div class="sub">Wallet Balance</div><div class="metric" id="walletBalance">N$ 0.00</div></div>
        <div class="card"><div class="sub">Drivers Registered All Time</div><div class="metric" id="driversAll">0</div></div>
        <div class="card"><div class="sub">Clients Registered All Time</div><div class="metric" id="clientsAll">0</div></div>
        <div class="card"><div class="sub">Team Agents</div><div class="metric" id="teamCount">0</div></div>
      </div>

      <div class="card">
        <h3 style="margin-top:0">My Registrations

<!-- ================= ADMIN MESSAGES ================= -->
<div style="margin-top:20px;padding:16px;border-radius:14px;background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.08);">
  <h3 style="margin:0 0 10px 0;">📩 Admin Messages</h3>
  <div style="color:#9ca3af;margin-bottom:10px;">Issues or feedback about your registrations</div>

  <div style="overflow:auto;max-height:300px;">
    <div class="table-wrap"><table style="width:100%;border-collapse:collapse;">
      <thead>
        <tr>
          <th>Time</th>
          <th>Type</th>
          <th>Registration</th>
          <th>Subject</th>
          <th>Message</th>
          <th>Status</th>
          <th>Action</th>
        </tr>
      </thead>
      <tbody id="agentInboxBody">
        <tr><td colspan="7" style="color:#aaa;">Loading messages...</td></tr>
      </tbody>
    </table></div>
  </div>
</div>

<script>
async function loadAgentInbox(){
  try{
    const res = await fetch('/api/agent/messages', {credentials:'same-origin'});
    const j = await res.json();

    const rows = Array.isArray(j?.rows) ? j.rows : [];
    const body = document.getElementById("agentInboxBody");

    if(!body) return;

    body.innerHTML = rows.length ? rows.map(r => `
      <tr>
        <td>${new Date(r.created_at).toLocaleString()}</td>
        <td>${r.registration_type || ""}</td>
        <td>${r.registration_id || ""}</td>
        <td>${r.subject || ""}</td>
        <td>${r.message || ""}</td>
        <td>${r.status || ""}</td>
        <td>
          ${r.status === "READ"
            ? "Seen"
            : `<button onclick="markMsgRead('${r.id}')">Mark Read</button>`
          }
        </td>
      </tr>
    `).join("") : `<tr><td colspan="7">No messages</td></tr>`;

  }catch(e){
    console.log("Inbox error:", e);
  }
}

async function markMsgRead(id){
  await fetch('/api/agent/messages/' + id + '/read', {
    method:'POST',
    credentials:'same-origin'
  });
  loadAgentInbox();
}

setTimeout(loadAgentInbox, 800);
</script>
</h3>
        <select id="activityPeriod" class="select" style="max-width:220px">
          <option value="day">Today</option>
          <option value="week" selected>This Week</option>
          <option value="all">All Previous Data</option>
        </select>
        <div class="table-wrap"><table>
          <thead><tr><th>Date</th><th>Type</th><th>Name</th><th>Phone</th><th>Town</th><th>Code</th></tr></thead>
          <tbody id="activityTable"><tr><td colspan="6">No registrations yet.</td></tr></tbody>
        </table></div>
      </div>
    </section>

    <section id="v-register" class="view">
      <div class="grid">
        <div class="card">
          <h3 style="margin-top:0">Register a Driver</h3>
          <form id="driverForm">
            <input id="d_name" class="input" placeholder="Driver Full Name" required>
            <input id="d_phone" class="input" placeholder="Driver WhatsApp Number" required>
            <input id="d_town" class="input" placeholder="Town / Region">
            <input id="d_license" class="input" placeholder="Driver License Number" required>
            <input id="d_car" class="input" placeholder="Car Details (e.g. Toyota Corolla Silver N1234)" required>
            <input id="d_code" class="input" placeholder="Driver App Code / Driver Code">
            <button class="btn" type="submit">Submit Driver</button>
          </form>
        </div>

        <div class="card">
          <h3 style="margin-top:0">Register a Client</h3>
          <form id="clientForm">
            <input id="c_name" class="input" placeholder="Client Full Name">
            <input id="c_phone" class="input" placeholder="Client Phone Number" required>
            <input id="c_code" class="input" placeholder="Client App Code / Rider Code">
            <button class="btn" type="submit">Submit Client</button>
          </form>
        </div>
      </div>
    </section>

    <section id="v-team" class="view">
      <div class="grid">
        <div class="card"><div class="sub">Team Agents</div><div class="metric" id="teamAgentsMetric">0</div></div>
        <div class="card"><div class="sub">Team Drivers Today</div><div class="metric" id="teamDriversDay">0</div></div>
        <div class="card"><div class="sub">Team Clients Today</div><div class="metric" id="teamClientsDay">0</div></div>
        <div class="card"><div class="sub">Team Drivers This Week</div><div class="metric" id="teamDriversWeek">0</div></div>
        <div class="card"><div class="sub">Team Clients This Week</div><div class="metric" id="teamClientsWeek">0</div></div>
      </div>

      <div class="card">
        <h3 style="margin-top:0">Your Team Link</h3>
        <div class="row">
          <input id="refLink" class="input" readonly style="margin:0">
          <button class="btn" type="button" onclick="copyRef()">Copy Link</button>
        </div>
      </div>

      <div class="card">
        <h3 style="margin-top:0">My Team Agents</h3>
        <div class="table-wrap"><table>
          <thead><tr><th>Name</th><th>Email</th><th>Today D/C</th><th>Week D/C</th><th>All D/C</th><th>Joined</th></tr></thead>
          <tbody id="teamTable"><tr><td colspan="6">No team agents yet.</td></tr></tbody>
        </table></div>
      </div>
    </section>

    <section id="v-leaderboard" class="view">
      <div class="card">
        <div class="row" style="align-items:center">
          <h3 style="margin:0;flex:1">Recruitment Leaderboard</h3>
          <select id="leaderboardPeriod" class="select" style="max-width:220px;margin:0">
            <option value="week" selected>This Week</option>
            <option value="month">This Month</option>
          </select>
        </div>
      </div>

      <div class="card">
        <h3 style="margin-top:0">Top Driver Recruiters</h3>
        <div class="table-wrap"><table>
          <thead><tr><th>Rank</th><th>Agent</th><th>Drivers Registered</th><th>Top Town</th></tr></thead>
          <tbody id="driverLeaderboardTable"><tr><td colspan="4">No driver leaderboard data yet.</td></tr></tbody>
        </table></div>
      </div>

      <div class="card">
        <h3 style="margin-top:0">Top Client Recruiters</h3>
        <div class="table-wrap"><table>
          <thead><tr><th>Rank</th><th>Agent</th><th>Clients Registered</th><th>Top Town</th></tr></thead>
          <tbody id="clientLeaderboardTable"><tr><td colspan="4">No client leaderboard data yet.</td></tr></tbody>
        </table></div>
      </div>
    </section>

    
    <section id="v-wallet" class="view">
      <div class="grid">
        <div class="card"><div class="sub">Available Balance</div><div class="metric" id="walletBalanceMain">N$ 0.00</div></div>
        <div class="card"><div class="sub">Pending Requests</div><div class="metric" id="walletPendingCount">0</div></div>
        <div class="card"><div class="sub">Approved Requests</div><div class="metric" id="walletApprovedCount">0</div></div>
        <div class="card"><div class="sub">Money Sent</div><div class="metric" id="walletSentCount">0</div></div>
      </div>

      <div class="card">
        <h3 style="margin-top:0">Request Withdrawal</h3>
        <form id="withdrawForm">
          <input id="withdrawAmount" class="input" placeholder="Amount in Namibia Dollar (N$)" required>
          <input id="withdrawNote" class="input" placeholder="Message to admin / finance">
          <button class="btn" type="submit">Request Withdraw</button>
        </form>
        <div class="sub" style="margin-top:8px">
          Status flow: Pending → Approved → Sent
        </div>
      </div>

      <div class="card">
        <h3 style="margin-top:0">Withdrawal Requests</h3>
        <div class="table-wrap"><table>
          <thead><tr><th>Date</th><th>Amount</th><th>Status</th><th>Admin Note</th></tr></thead>
          <tbody id="withdrawTable"><tr><td colspan="4">No withdrawal requests yet.</td></tr></tbody>
        </table></div>
      </div>

      <div class="card">
        <h3 style="margin-top:0">Wallet Ledger / Receipts</h3>
        <div class="table-wrap"><table>
          <thead><tr><th>Date</th><th>Type</th><th>Amount</th><th>Description</th><th>Status</th><th>Invoice</th></tr></thead>
          <tbody id="walletHistoryTable"><tr><td colspan="6">No wallet records yet.</td></tr></tbody>
        </table></div>
      </div>
    </section>


    <section id="v-marketing" class="view">
      <div class="card">
        <h3 style="margin-top:0">Marketing Studio</h3>
        <div class="sub">Post on WhatsApp, campuses, offices, malls, Facebook groups, car wash points, taxi ranks, and community pages.</div>
      </div>
    </section>

    <section id="v-settings" class="view">
      <div class="card">
        <h3 style="margin-top:0">Profile Settings</h3>
        <form id="settingsForm">
          <input id="s_full_name" class="input" placeholder="Full Name">
          <input id="s_phone" class="input" placeholder="Cellphone Number">
          <input id="s_email" class="input" placeholder="Email">
          <input id="s_profile_picture_url" class="input" placeholder="Profile Picture URL">
          <input id="s_residential_address" class="input" placeholder="Residential Address">
          <input id="s_operation_region" class="input" placeholder="Operation Region">
          <input id="s_pin" class="input" placeholder="New PIN">
          <button class="btn" type="submit">Save Settings</button>
        </form>
      </div>
    </section>
  </main>
</div>

<script>
  function showView(id, el){
    document.querySelectorAll('.view').forEach(v => v.classList.remove('active'));
    document.getElementById(id).classList.add('active');
    document.querySelectorAll('.item').forEach(i => i.classList.remove('active'));
    if(el) el.classList.add('active');
  }

  function setStatus(msg, type=''){
    const box = document.getElementById('statusBox');
    box.className = 'status' + (type ? ' ' + type : '');
    box.innerHTML = msg;
  }

  function money(v){ return 'N$ ' + Number(v || 0).toFixed(2); }

  async function apiGet(path){
    const r = await fetch(path, { credentials:'same-origin' });
    const txt = await r.text();
    try { return JSON.parse(txt); } catch { return { ok:false, error:txt }; }
  }

  async function apiPost(path, payload){
    const r = await fetch(path, {
      method:'POST',
      headers:{'Content-Type':'application/json'},
      credentials:'same-origin',
      body: JSON.stringify(payload)
    });
    const txt = await r.text();
    try { return JSON.parse(txt); } catch { return { ok:false, error:txt }; }
  }

  function renderActivity(rows){
    const body = document.getElementById('activityTable');
    body.innerHTML = '';
    if(!rows || rows.length === 0){
      body.innerHTML = '<tr><td colspan="6">No registrations yet.</td></tr>';
      return;
    }
    rows.forEach(r => {
      const tr = document.createElement('tr');
      tr.innerHTML = `<td>${r.created_at ? new Date(r.created_at).toLocaleString() : ''}</td><td>${r.subject_type || ''}</td><td>${r.full_name || ''}</td><td>${r.phone || ''}</td><td>${r.town || ''}</td><td>${r.external_code || ''}</td>`;
      body.appendChild(tr);
    });
  }

  function renderTeam(rows){
    const body = document.getElementById('teamTable');
    body.innerHTML = '';
    if(!rows || rows.length === 0){
      body.innerHTML = '<tr><td colspan="6">No team agents yet.</td></tr>';
      return;
    }
    rows.forEach(r => {
      const tr = document.createElement('tr');
      tr.innerHTML = `<td>${r.full_name || ''}</td><td>${r.email || ''}</td><td>${r.drivers_day || 0}/${r.clients_day || 0}</td><td>${r.drivers_week || 0}/${r.clients_week || 0}</td><td>${r.drivers_all || 0}/${r.clients_all || 0}</td><td>${r.joined_at ? new Date(r.joined_at).toLocaleString() : ''}</td>`;
      body.appendChild(tr);
    });
  }

  function renderLeaderboardDrivers(rows){
    const body = document.getElementById('driverLeaderboardTable');
    body.innerHTML = '';
    if(!rows || rows.length === 0){
      body.innerHTML = '<tr><td colspan="4">No driver leaderboard data yet.</td></tr>';
      return;
    }
    rows.forEach((r, i) => {
      const tr = document.createElement('tr');
      tr.innerHTML = `<td>${i + 1}</td><td>${r.agent_name || ''}</td><td>${r.count || 0}</td><td>${r.town || ''}</td>`;
      body.appendChild(tr);
    });
  }

  function renderLeaderboardClients(rows){
    const body = document.getElementById('clientLeaderboardTable');
    body.innerHTML = '';
    if(!rows || rows.length === 0){
      body.innerHTML = '<tr><td colspan="4">No client leaderboard data yet.</td></tr>';
      return;
    }
    rows.forEach((r, i) => {
      const tr = document.createElement('tr');
      tr.innerHTML = `<td>${i + 1}</td><td>${r.agent_name || ''}</td><td>${r.count || 0}</td><td>${r.town || ''}</td>`;
      body.appendChild(tr);
    });
  }

  function renderWallet(rows){
    const body = document.getElementById('walletTable');
    body.innerHTML = '';
    if(!rows || rows.length === 0){
      body.innerHTML = '<tr><td colspan="4">No wallet transactions yet.</td></tr>';
      return;
    }
    rows.forEach(r => {
      const tr = document.createElement('tr');
      tr.innerHTML = `<td>${r.created_at ? new Date(r.created_at).toLocaleString() : ''}</td><td>${r.txn_type || ''}</td><td>${money(r.amount || 0)}</td><td>${r.description || ''}</td>`;
      body.appendChild(tr);
    });
  }

  async function loadDashboard(){
    setStatus('Loading dashboard...');
    const me = await apiGet('/api/agent/me_v4');
    if(!me.ok){
      setStatus('Your server login session is missing. Please login again.', 'error');
      return;
    }

    const p = me.profile || {};
    document.getElementById('welcomeText').textContent = 'Welcome, ' + (p.full_name || p.email || 'Agent');
    document.getElementById('s_full_name').value = p.full_name || '';
    document.getElementById('s_phone').value = p.phone || '';
    document.getElementById('s_email').value = p.email || '';
    document.getElementById('s_profile_picture_url').value = p.profile_picture_url || '';
    document.getElementById('s_residential_address').value = p.residential_address || '';
    document.getElementById('s_operation_region').value = p.operation_region || '';
    document.getElementById('s_pin').value = p.pin || '';

    const summary = await apiGet('/api/agent/summary_v4');
    if(summary.ok){
      document.getElementById('weekLabel').textContent = 'Week: ' + (summary.week_start || '') + ' → ' + (summary.week_end || '');
      document.getElementById('weeklyEarnings').textContent = money(summary.earnings_week);
      document.getElementById('weeklyDrivers').textContent = summary.drivers_week || 0;
      document.getElementById('weeklyClients').textContent = summary.clients_week || 0;
      document.getElementById('walletBalance').textContent = money(summary.wallet_balance);
      document.getElementById('driversAll').textContent = summary.drivers_all || 0;
      document.getElementById('clientsAll').textContent = summary.clients_all || 0;
      document.getElementById('teamCount').textContent = summary.team_agents_count || 0;
      document.getElementById('teamAgentsMetric').textContent = summary.team_agents_count || 0;
      document.getElementById('refLink').value = window.location.origin + (summary.referral_link || '/join');
    }

    const act = await apiGet('/api/agent/activity_v4?period=' + encodeURIComponent(document.getElementById('activityPeriod').value));
    renderActivity(act.ok ? act.rows : []);

    const team = await apiGet('/api/agent/team_v4');
    renderTeam(team.ok ? team.rows : []);

    const teamSummary = await apiGet('/api/agent/team_summary_v4');
    if(teamSummary.ok && teamSummary.summary){
      document.getElementById('teamDriversDay').textContent = teamSummary.summary.drivers_day || 0;
      document.getElementById('teamClientsDay').textContent = teamSummary.summary.clients_day || 0;
      document.getElementById('teamDriversWeek').textContent = teamSummary.summary.drivers_week || 0;
      document.getElementById('teamClientsWeek').textContent = teamSummary.summary.clients_week || 0;
    }

    const leaderboardPeriod = document.getElementById('leaderboardPeriod') ? document.getElementById('leaderboardPeriod').value : 'week';
    const leaderboard = await apiGet('/api/agent/leaderboard_v4?period=' + encodeURIComponent(leaderboardPeriod));
    renderLeaderboardDrivers(leaderboard.ok ? leaderboard.top_driver_recruiters : []);
    renderLeaderboardClients(leaderboard.ok ? leaderboard.top_client_recruiters : []);

    await loadWalletData();

    setStatus('Dashboard loaded successfully.', 'ok');
  }

  async function submitDriver(e){
    e.preventDefault();
    const payload = {
      full_name: document.getElementById('d_name').value.trim(),
      phone: document.getElementById('d_phone').value.trim(),
      town: document.getElementById('d_town').value.trim(),
      license_number: document.getElementById('d_license').value.trim(),
      car_details: document.getElementById('d_car').value.trim(),
      external_code: document.getElementById('d_code').value.trim()
    };
    const res = await apiPost('/api/agent/register_driver_v3', payload);
    if(res.ok){
      document.getElementById('driverForm').reset();
      setStatus('Driver registered successfully.', 'ok');
      await loadDashboard();
    } else {
      setStatus('Driver registration failed: ' + (res.error || 'Unknown error'), 'error');
    }
  }

  async function submitClient(e){
    e.preventDefault();
    const payload = {
      full_name: document.getElementById('c_name').value.trim(),
      phone: document.getElementById('c_phone').value.trim(),
      external_code: document.getElementById('c_code').value.trim()
    };
    const res = await apiPost('/api/agent/register_client_v3', payload);
    if(res.ok){
      document.getElementById('clientForm').reset();
      setStatus('Client registered successfully.', 'ok');
      await loadDashboard();
    } else {
      setStatus('Client registration failed: ' + (res.error || 'Unknown error'), 'error');
    }
  }

  async function saveSettings(e){
    e.preventDefault();
    const payload = {
      full_name: document.getElementById('s_full_name').value.trim(),
      phone: document.getElementById('s_phone').value.trim(),
      email: document.getElementById('s_email').value.trim(),
      profile_picture_url: document.getElementById('s_profile_picture_url').value.trim(),
      residential_address: document.getElementById('s_residential_address').value.trim(),
      operation_region: document.getElementById('s_operation_region').value.trim(),
      pin: document.getElementById('s_pin').value.trim()
    };
    const res = await apiPost('/api/agent/settings_v4', payload);
    if(res.ok){
      setStatus('Settings updated successfully.', 'ok');
      await loadDashboard();
    } else {
      setStatus('Settings update failed: ' + (res.error || 'Unknown error'), 'error');
    }
  }

  async function copyRef(){
    try{
      await navigator.clipboard.writeText(document.getElementById('refLink').value);
      setStatus('Referral link copied.', 'ok');
    }catch(e){
      setStatus('Could not copy referral link automatically.', 'error');
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    document.getElementById('driverForm').addEventListener('submit', submitDriver);
    document.getElementById('clientForm').addEventListener('submit', submitClient);
    document.getElementById('settingsForm').addEventListener('submit', saveSettings);
    if(document.getElementById('withdrawForm')){ document.getElementById('withdrawForm').addEventListener('submit', submitWithdrawRequest); }
    document.getElementById('activityPeriod').addEventListener('change', loadDashboard);
    if(document.getElementById('leaderboardPeriod')){
      document.getElementById('leaderboardPeriod').addEventListener('change', loadDashboard);
    }
    loadDashboard();
  });

function renderWalletHistory(rows){
  const body = document.getElementById('walletHistoryTable');
  if(!body) return;
  body.innerHTML = '';
  if(!rows || rows.length === 0){
    body.innerHTML = '<tr><td colspan="6">No wallet records yet.</td></tr>';
    return;
  }
  rows.forEach(r => {
    const tr = document.createElement('tr');
    const btn = r.id ? `<a class="btn dark" style="padding:8px 10px;display:inline-block;text-decoration:none" href="/api/agent/wallet_invoice_v1/${r.id}">Invoice</a>` : '';
    tr.innerHTML = `<td>${r.created_at ? new Date(r.created_at).toLocaleString() : ''}</td><td>${r.txn_type || ''}</td><td>${money(r.amount || 0)}</td><td>${r.description || ''}</td><td>${r.status || ''}</td><td>${btn}</td>`;
    body.appendChild(tr);
  });
}

function renderWithdrawals(rows){
  const body = document.getElementById('withdrawTable');
  if(!body) return;
  body.innerHTML = '';
  if(!rows || rows.length === 0){
    body.innerHTML = '<tr><td colspan="4">No withdrawal requests yet.</td></tr>';
    return;
  }
  rows.forEach(r => {
    const status = (r.status || '').toLowerCase();
    let shown = r.status || '';
    if(status === 'approved'){
      shown = 'Approved - waiting for admin / finance to send money';
    }else if(status === 'sent'){
      shown = '✅ Money sent by admin';
    }else if(status === 'pending'){
      shown = 'Pending admin approval';
    }
    const tr = document.createElement('tr');
    tr.innerHTML = `<td>${r.created_at ? new Date(r.created_at).toLocaleString() : ''}</td><td>${money(r.request_amount || 0)}</td><td>${shown}</td><td>${r.admin_note || ''}</td>`;
    body.appendChild(tr);
  });
}

async function loadWalletData(){
  const sum = await apiGet('/api/agent/wallet_summary_v1');
  if(sum.ok){
    document.getElementById('walletBalanceMain').textContent = money(sum.balance || 0);
    document.getElementById('walletPendingCount').textContent = sum.pending_requests || 0;
    document.getElementById('walletApprovedCount').textContent = sum.approved_requests || 0;
    document.getElementById('walletSentCount').textContent = sum.sent_requests || 0;
  }

  const hist = await apiGet('/api/agent/wallet_history_v1');
  renderWalletHistory(hist.ok ? hist.rows : []);

  const reqs = await apiGet('/api/agent/withdraw_requests_v1');
  renderWithdrawals(reqs.ok ? reqs.rows : []);
}

async function submitWithdrawRequest(e){
  e.preventDefault();
  const payload = {
    amount: document.getElementById('withdrawAmount').value.trim(),
    note: document.getElementById('withdrawNote').value.trim()
  };
  const r = await apiPost('/api/agent/request_withdraw_v1', payload);
  if(r.ok){
    document.getElementById('withdrawForm').reset();
    setStatus('Withdrawal request submitted successfully.', 'ok');
    await loadWalletData();
  }else{
    setStatus('Withdraw request failed: ' + (r.error || 'Unknown error'), 'error');
  }
}

</script>
{% endblock %}


<script id="agent-hamburger-menu-script">
(function(){
  function $(id){ return document.getElementById(id); }

  const toggle = $("yeneMenuToggle");
  const panel = $("yeneMenuPanel");
  const backdrop = $("yeneMenuBackdrop");
  if(!toggle || !panel || !backdrop) return;

  function openMenu(){
    panel.classList.add("open");
    backdrop.classList.add("show");
    document.body.classList.add("menu-open");
    toggle.setAttribute("aria-expanded", "true");
    panel.setAttribute("aria-hidden", "false");
  }

  function closeMenu(){
    panel.classList.remove("open");
    backdrop.classList.remove("show");
    document.body.classList.remove("menu-open");
    toggle.setAttribute("aria-expanded", "false");
    panel.setAttribute("aria-hidden", "true");
  }

  function toggleMenu(){
    if(panel.classList.contains("open")) closeMenu();
    else openMenu();
  }

  function getSectionMap(){
    return {
      dashboard: [
        "[data-section='dashboard']",
        "#dashboard",
        ".dashboard-section",
        "main"
      ],
      register: [
        "[data-section='register']",
        "#register",
        "#register-network"
      ],
      team: [
        "[data-section='team']",
        "#team",
        "#team-rewards"
      ],
      leaderboard: [
        "[data-section='leaderboard']",
        "#leaderboard"
      ],
      wallet: [
        "[data-section='wallet']",
        "#wallet"
      ],
      marketing: [
        "[data-section='marketing']",
        "#marketing"
      ],
      settings: [
        "[data-section='settings']",
        "#settings"
      ]
    };
  }

  function scrollToSection(name){
    const map = getSectionMap();
    const selectors = map[name] || [];
    let target = null;

    for(const sel of selectors){
      target = document.querySelector(sel);
      if(target) break;
    }

    if(target){
      target.scrollIntoView({behavior:"smooth", block:"start"});
    }
  }

  function setActive(name){
    panel.querySelectorAll(".menu-link").forEach(el => el.classList.remove("active"));
    const activeBtn = panel.querySelector(`.menu-link[data-target="${name}"]`);
    if(activeBtn) activeBtn.classList.add("active");
  }

  function autoDetectActive(){
    const map = getSectionMap();
    let best = "dashboard";
    let bestTop = Infinity;

    for(const [name, selectors] of Object.entries(map)){
      for(const sel of selectors){
        const el = document.querySelector(sel);
        if(el){
          const top = Math.abs(el.getBoundingClientRect().top);
          if(top < bestTop){
            bestTop = top;
            best = name;
          }
          break;
        }
      }
    }
    setActive(best);
  }

  toggle.addEventListener("click", toggleMenu);
  backdrop.addEventListener("click", closeMenu);

  panel.addEventListener("click", function(e){
    const btn = e.target.closest(".menu-link");
    if(!btn) return;

    const action = btn.getAttribute("data-action");
    const target = btn.getAttribute("data-target");

    if(action === "refresh"){
      location.reload();
      return;
    }

    if(target){
      setActive(target);
      scrollToSection(target);
      closeMenu();
    }
  });

  document.addEventListener("keydown", function(e){
    if(e.key === "Escape") closeMenu();
  });

  window.addEventListener("scroll", function(){
    autoDetectActive();
  }, {passive:true});

  autoDetectActive();
})();
</script>
