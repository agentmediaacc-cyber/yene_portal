<style id="agent-hamburger-menu-upgrade">
#yeneMenuToggle{
  position:fixed;
  top:14px;
  right:14px;
  z-index:9999;
  border:none;
  border-radius:14px;
  padding:12px 14px;
  font-size:20px;
  line-height:1;
  cursor:pointer;
  background:rgba(7,17,31,.88);
