}

#yeneMenuPanel a,
#yeneMenuPanel button.menu-link{
  display:flex;
  align-items:center;
  width:100%;
  text-align:left;
  gap:10px;
  padding:12px 12px;
  margin:4px 0;
  border:none;
  border-radius:12px;
  background:transparent;
  color:#f4f8ff;
  text-decoration:none;
  cursor:pointer;
  font-size:14px;
  font-weight:700;
}

#yeneMenuPanel a:hover,
#yeneMenuPanel button.menu-link:hover{
  background:rgba(255,255,255,.08);
}

#yeneMenuPanel a.active,
#yeneMenuPanel button.menu-link.active{
  background:linear-gradient(90deg, rgba(102,199,255,.22), rgba(14,165,233,.18));
  border:1px solid rgba(102,199,255,.25);
}

#yeneMenuBackdrop{
  position:fixed;
  inset:0;
  background:rgba(0,0,0,.28);
  z-index:9997;
  display:none;
}

#yeneMenuBackdrop.show{
  display:block;
}

/* hide old nav visually on smaller screens, keep on desktop if you want */
@media (max-width: 900px){
  nav, .navbar, .topbar, .sidebar{
    display:none !important;
  }
}

/* keep hamburger visible on all sizes for consistency */
body.menu-open{
  overflow:hidden;
}
</style>

{% extends 'base.html' %}
{% block content %}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js">
function renderWalletHistory(rows){
  const body = document.getElementById('walletHistoryTable');
  if(!body) return;
  body.innerHTML = '';
  if(!rows || rows.length === 0){
    body.innerHTML = '<tr><td colspan="6">No wallet records yet.</td></tr>';
    return;
  }
  rows.forEach(r => {
    const tr = document.createElement('tr');
    const btn = r.id ? `<a class="btn dark" style="padding:8px 10px;display:inline-block;text-decoration:none" href="/api/agent/wallet_invoice_v1/${r.id}">Invoice</a>` : '';
    tr.innerHTML = `<td>${r.created_at ? new Date(r.created_at).toLocaleString() : ''}</td><td>${r.txn_type || ''}</td><td>${money(r.amount || 0)}</td><td>${r.description || ''}</td><td>${r.status || ''}</td><td>${btn}</td>`;
    body.appendChild(tr);
  });
}

function renderWithdrawals(rows){
  const body = document.getElementById('withdrawTable');
  if(!body) return;
  body.innerHTML = '';
  if(!rows || rows.length === 0){
    body.innerHTML = '<tr><td colspan="4">No withdrawal requests yet.</td></tr>';
    return;
  }
  rows.forEach(r => {
    const status = (r.status || '').toLowerCase();
    let shown = r.status || '';
    if(status === 'approved'){
      shown = 'Approved - waiting for admin / finance to send money';
    }else if(status === 'sent'){
      shown = '✅ Money sent by admin';
    }else if(status === 'pending'){
      shown = 'Pending admin approval';
    }
    const tr = document.createElement('tr');
    tr.innerHTML = `<td>${r.created_at ? new Date(r.created_at).toLocaleString() : ''}</td><td>${money(r.request_amount || 0)}</td><td>${shown}</td><td>${r.admin_note || ''}</td>`;
    body.appendChild(tr);
  });
}

async function loadWalletData(){
  const sum = await apiGet('/api/agent/wallet_summary_v1');
  if(sum.ok){
    document.getElementById('walletBalanceMain').textContent = money(sum.balance || 0);
    document.getElementById('walletPendingCount').textContent = sum.pending_requests || 0;
    document.getElementById('walletApprovedCount').textContent = sum.approved_requests || 0;
    document.getElementById('walletSentCount').textContent = sum.sent_requests || 0;
  }

  const hist = await apiGet('/api/agent/wallet_history_v1');
  renderWalletHistory(hist.ok ? hist.rows : []);

  const reqs = await apiGet('/api/agent/withdraw_requests_v1');
  renderWithdrawals(reqs.ok ? reqs.rows : []);
}

async function submitWithdrawRequest(e){
  e.preventDefault();
  const payload = {
    amount: document.getElementById('withdrawAmount').value.trim(),
    note: document.getElementById('withdrawNote').value.trim()
  };
  const r = await apiPost('/api/agent/request_withdraw_v1', payload);
  if(r.ok){
    document.getElementById('withdrawForm').reset();
    setStatus('Withdrawal request submitted successfully.', 'ok');
    await loadWalletData();
  }else{
    setStatus('Withdraw request failed: ' + (r.error || 'Unknown error'), 'error');
  }
}

</script>


<style id="agent-dashboard-mobile-upgrade">
:root{
  --bg:#07111f;
  --bg2:#0b1830;
  --card:rgba(7,17,31,.72);
  --card-strong:rgba(10,24,48,.82);
  --line:rgba(255,255,255,.10);
  --text:#f4f8ff;
  --muted:#b9c7e6;
  --accent:#66c7ff;
  --accent2:#0ea5e9;
  --ok:#22c55e;
  --warn:#f59e0b;
  --bad:#ef4444;
  --shadow:0 18px 40px rgba(0,0,0,.30);
}

html{
  scroll-behavior:smooth;
}

body{
  min-height:100vh;
  color:var(--text) !important;
  background:
    linear-gradient(rgba(4,10,20,.54), rgba(4,10,20,.76)),
    radial-gradient(circle at top right, rgba(102,199,255,.15), transparent 30%),
    radial-gradient(circle at bottom left, rgba(14,165,233,.12), transparent 28%),
    url('https://images.unsplash.com/photo-1507525428034-b723cf961d3e?auto=format&fit=crop&w=1600&q=80') center/cover fixed !important;
  overflow-x:hidden;
}

/* Generic layout guards */
*{
  box-sizing:border-box;
}

img, table, iframe, pre, code{
  max-width:100%;
}

body, main, section, div{
  word-wrap:break-word;
}

/* Main wrapper */
.main-content, .container, .dashboard-container, .content, .page, .wrap{
  width:min(1200px, calc(100% - 24px)) !important;
  margin-left:auto !important;
  margin-right:auto !important;
}

/* Cards / panels */
.card, .panel, .box, .stat-card, .metric-card, .dashboard-card, .tile{
  background:var(--card) !important;
  backdrop-filter:blur(10px);
  -webkit-backdrop-filter:blur(10px);
  border:1px solid var(--line) !important;
  border-radius:18px !important;
  box-shadow:var(--shadow);
  overflow:hidden;
}

/* Header / nav buttons */
a, button{
  touch-action:manipulation;
}

button, .btn, a.btn{
  border-radius:12px !important;
  min-height:42px;
}

/* Prevent pop-out / overlap */
.modal, .dropdown, .popover, .menu{
  max-width:min(96vw, 420px);
}

table{
  border-collapse:collapse;
}

th, td{
  vertical-align:top;
  white-space:normal;
}

/* Responsive tables */
.table-wrap, .table-container, .table-responsive, .overflow-x-auto{
  width:100%;
  overflow-x:auto !important;
  -webkit-overflow-scrolling:touch;
  border-radius:14px;
}

.table-wrap table, .table-container table, .table-responsive table, table{
  min-width:720px;
}

/* Admin messages and registrations sections */
#agentInboxCard,
#agentInboxBody,
#registrations,
#myRegistrations,
#registrationTable,
#registration-list{
  max-width:100%;
}

/* Friendly scrolling blocks */
.scroll-area, .list, .feed, .messages, .history{
  overflow:auto;
  -webkit-overflow-scrolling:touch;
}

/* Typography */
h1, h2, h3{
  line-height:1.15;
}
p, li, td, th, span, label, input, select, textarea, button{
  font-size:14px;
}

/* Inputs */
input, select, textarea{
  width:100%;
  max-width:100%;
  border-radius:12px !important;
  border:1px solid var(--line) !important;
  background:rgba(255,255,255,.06) !important;
  color:var(--text) !important;
  padding:12px 14px !important;
  outline:none;
}

input::placeholder, textarea::placeholder{
  color:#d4ddf3aa;
}

/* Mobile-first stack helpers */
.stats-grid, .cards-grid, .dashboard-grid, .metrics-grid, .top-grid, .grid{
  display:grid;
  grid-template-columns:repeat(3, minmax(0, 1fr));
  gap:14px;
}

@media (max-width: 1100px){
  .stats-grid, .cards-grid, .dashboard-grid, .metrics-grid, .top-grid, .grid{
    grid-template-columns:repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 760px){
  body{
    background-attachment:scroll !important;
  }

  .main-content, .container, .dashboard-container, .content, .page, .wrap{
    width:calc(100% - 16px) !important;
  }

  .stats-grid, .cards-grid, .dashboard-grid, .metrics-grid, .top-grid, .grid{
    grid-template-columns:1fr !important;
    gap:12px;
  }

  h1{
    font-size:24px !important;
  }

  h2{
    font-size:18px !important;
  }

  h3{
    font-size:16px !important;
  }

  .card, .panel, .box, .stat-card, .metric-card, .dashboard-card, .tile{
    padding:14px !important;
    border-radius:16px !important;
  }

  nav, .topbar, .header, .navbar{
    position:sticky;
    top:0;
    z-index:50;
    backdrop-filter:blur(10px);
    -webkit-backdrop-filter:blur(10px);
  }

  .topbar, .header, .navbar{
    overflow-x:auto;
    white-space:nowrap;
    padding-bottom:4px;
  }

  .topbar a, .header a, .navbar a, .topbar button, .header button, .navbar button{
    display:inline-flex !important;
    align-items:center;
    justify-content:center;
    margin-right:8px;
  }

  .table-wrap table, .table-container table, .table-responsive table, table{
    min-width:640px;
  }

  th, td{
    padding:10px 8px !important;
    font-size:13px !important;
  }

  input, select, textarea{
    font-size:16px !important; /* prevents iPhone zoom */
  }

  .row, .actions, .toolbar, .button-row{
    display:flex;
    flex-direction:column;
    gap:10px;
  }

  .row > *, .actions > *, .toolbar > *, .button-row > *{
    width:100% !important;
  }
}

@media (max-width: 460px){
  .main-content, .container, .dashboard-container, .content, .page, .wrap{
    width:calc(100% - 12px) !important;
  }

  .card, .panel, .box, .stat-card, .metric-card, .dashboard-card, .tile{
    padding:12px !important;
    border-radius:14px !important;
  }

  th, td{
    font-size:12px !important;
  }
}
</style>

<style>
  :root{
    --yene:#4aa8ff;--bg:#0b1220;--panel:#0f1a2f;--card:#111b2e;--card2:#0b1427;
    --text:#eaf2ff;--muted:#a9b7d6;--line:rgba(255,255,255,.10);--ok:#2ed573;--danger:#ff6b6b
  }
  *{box-sizing:border-box}
  html,body{margin:0;padding:0;background:var(--bg);color:var(--text);font-family:system-ui,-apple-system,Segoe UI,Roboto,Arial,sans-serif}
  .shell{display:flex;min-height:100vh}
  .sidebar{width:270px;background:var(--panel);border-right:1px solid var(--line);display:flex;flex-direction:column}
  .brand{padding:18px;border-bottom:1px solid var(--line);font-weight:900;color:var(--yene);font-size:22px}
  .nav{padding:12px 10px;flex:1;overflow:auto}
  .item{display:flex;align-items:center;gap:10px;padding:13px 14px;border-radius:12px;color:var(--muted);cursor:pointer;margin-bottom:6px;font-weight:700}
  .item:hover,.item.active{background:rgba(74,168,255,.15);color:#fff}
  .main{flex:1;padding:20px;overflow-x:hidden}
  .topbar{display:flex;justify-content:space-between;align-items:flex-start;gap:12px;flex-wrap:wrap;margin-bottom:18px}
  .title{font-size:30px;font-weight:900;margin:0 0 6px}
  .status{padding:12px 14px;border-radius:12px;margin-bottom:16px;background:rgba(74,168,255,.08);border:1px solid rgba(74,168,255,.25)}
  .status.error{background:rgba(255,107,107,.08);border-color:rgba(255,107,107,.25)}
  .status.ok{background:rgba(46,213,115,.08);border-color:rgba(46,213,115,.22)}
  .grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:14px;margin-bottom:18px}
  .card{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:16px;margin-bottom:16px}
  .metric{font-size:32px;font-weight:900;color:var(--yene);margin:8px 0}
  .sub{color:var(--muted);font-size:13px;line-height:1.45}
  .btn{background:var(--yene);color:#041021;padding:12px 14px;border:none;border-radius:12px;font-weight:900;cursor:pointer}
  .btn.dark{background:var(--card2);color:#fff;border:1px solid var(--line)}
  .btn.red{background:var(--danger);color:#fff}
  .row{display:flex;gap:12px;flex-wrap:wrap}
  .row>*{flex:1;min-width:180px}
  .input,.select{width:100%;padding:13px 14px;border-radius:12px;border:1px solid var(--line);background:var(--card2);color:#fff;outline:none;margin-bottom:12px}
  table{width:100%;border-collapse:collapse}
  th,td{padding:12px 10px;border-bottom:1px solid var(--line);text-align:left;font-size:14px}
  th{color:var(--yene);text-transform:uppercase;font-size:12px}
  .view{display:none}.view.active{display:block}
  .pill{display:inline-block;padding:6px 10px;border-radius:999px;font-size:12px;font-weight:800;background:rgba(74,168,255,.14);border:1px solid rgba(74,168,255,.22)}
  .mobile-actions{display:none}
  .sticky-top{position:sticky;top:0;z-index:5;background:var(--bg);padding-bottom:8px}
  .flyer{width:100%;max-width:420px;aspect-ratio:4/5;background:linear-gradient(135deg,#0b1220 0%,#1a2a47 100%);border:2px solid var(--yene);border-radius:18px;padding:24px;text-align:center;position:relative;overflow:hidden;margin:0 auto}
  .flyer-title{font-size:28px;font-weight:900}
  .flyer-footer{position:absolute;bottom:18px;left:0;width:100%;font-size:12px;color:var(--muted)}
  @media (max-width: 980px){
    .shell{display:block}
    .sidebar{width:100%;border-right:none;border-bottom:1px solid var(--line)}
    .brand{font-size:20px}
    .main{padding:12px}
    .topbar{display:block}
    .title{font-size:24px}
    .grid{grid-template-columns:1fr 1fr}
    .row{display:block}
    .row>*{min-width:100%;margin-bottom:10px}
    table{display:block;overflow-x:auto;white-space:nowrap}
    .mobile-actions{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:14px}
    .sidebar .nav{display:grid;grid-template-columns:1fr 1fr;gap:6px}
    .item{margin-bottom:0}
  }
  @media (max-width: 640px){
    .grid{grid-template-columns:1fr}
    .metric{font-size:28px}
    .card{padding:14px}
    .btn{width:100%}
    .sidebar .nav{grid-template-columns:1fr}
  }
</style>

<div class="shell">
