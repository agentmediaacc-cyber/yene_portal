<script>
(function(){
  function esc(v){
    return String(v ?? "")
      .replace(/&/g,"&amp;")
      .replace(/</g,"&lt;")
      .replace(/>/g,"&gt;")
      .replace(/"/g,"&quot;");
  }

  function getAgentName(){
    try{
      const hero = document.getElementById('heroTitle');
      if(hero){
        const t = (hero.textContent || '').trim();
        if(t.toLowerCase().startsWith('welcome,')) return t.split(',').slice(1).join(',').trim().toLowerCase();
      }
    }catch(_){}
    return '';
  }

  function getPeriod(){
    const active = document.querySelector('.leader-btn.active');
    if(!active) return 'week';
    const p = (active.dataset.period || 'week').trim().toLowerCase();
    if(p === 'month' || p === 'all' || p === 'week') return p;
    return 'week';
  }

  function countOf(row){
    return Number(row?.count || row?.total || 0);
  }

  function townOf(row){
    return String(row?.town || row?.top_town || '—');
  }

  function nameOf(row){
    return String(row?.agent_name || row?.full_name || row?.name || row?.agent || 'Agent');
  }

  function fillTable(tbodyId, rows, kindLabel){
    const body = document.getElementById(tbodyId);
    if(!body) return;
    if(!Array.isArray(rows) || !rows.length){
      body.innerHTML = `<tr><td colspan="4" class="muted">No ${kindLabel} leaderboard data yet.</td></tr>`;
      return;
    }
    body.innerHTML = rows.map((r, i) => `
      <tr>
        <td>${i + 1}</td>
        <td>${esc(nameOf(r))}</td>
        <td>${countOf(r)}</td>
        <td>${esc(townOf(r))}</td>
      </tr>
    `).join('');
  }

  function fillRank(rows, myName, rankId, subId, label){
    const rankEl = document.getElementById(rankId);
    const subEl = document.getElementById(subId);
    if(!rankEl || !subEl) return;

    if(!Array.isArray(rows) || !rows.length || !myName){
      rankEl.textContent = '-';
      subEl.textContent = 'No live rank found yet';
      return;
    }

    const idx = rows.findIndex(r => nameOf(r).trim().toLowerCase() === myName);
    if(idx < 0){
      rankEl.textContent = '-';
      subEl.textContent = `Not ranked on ${label} yet`;
      return;
    }

    const value = countOf(rows[idx]);
    rankEl.textContent = '#' + (idx + 1);
    subEl.textContent = `${value} ${label}`;
  }

  function fillCompetition(listId, rows, target, label){
    const el = document.getElementById(listId);
    if(!el) return;

    const ranked = (Array.isArray(rows) ? rows : [])
      .filter(r => countOf(r) > 0)
      .sort((a,b) => countOf(b) - countOf(a))
      .slice(0,3);

    if(!ranked.length){
      el.innerHTML = '<div class="muted">Your progress will grow as you add more registrations.</div>';
      return;
    }

    el.innerHTML = ranked.map((r, i) => {
      const val = countOf(r);
      const left = Math.max(0, target - val);
      return `
        <div class="list-item">
          <div class="stack">
            <div class="title">#${i+1} ${esc(nameOf(r))}</div>
            <div class="sub">${label} • ${val}/${target} • ${left} left</div>
          </div>
        </div>
      `;
    }).join('');
  }

  function setProgress(textId, barId, value, target){
    const textEl = document.getElementById(textId);
    const barEl = document.getElementById(barId);
    if(textEl) textEl.textContent = `${value} / ${target}`;
    if(barEl){
      const pct = Math.max(0, Math.min(100, (Number(value || 0) / target) * 100));
      barEl.style.width = pct + '%';
    }
  }

  function fillRivals(driverRows, clientRows, myName){
    const el = document.getElementById('rivalTrackerList');
    if(!el) return;

    const rivals = [];

    const dIdx = driverRows.findIndex(r => nameOf(r).trim().toLowerCase() === myName);
    const cIdx = clientRows.findIndex(r => nameOf(r).trim().toLowerCase() === myName);

    if(dIdx > 0){
      const ahead = driverRows[dIdx - 1];
      rivals.push({
        icon:'🚗',
        title:`Pass ${nameOf(ahead)} on drivers`,
        sub:`${Math.max(1, countOf(ahead) - countOf(driverRows[dIdx]))} more driver(s) to overtake`
      });
    }
    if(cIdx > 0){
      const ahead = clientRows[cIdx - 1];
      rivals.push({
        icon:'👤',
        title:`Pass ${nameOf(ahead)} on clients`,
        sub:`${Math.max(1, countOf(ahead) - countOf(clientRows[cIdx]))} more client(s) to overtake`
      });
    }
    if(!rivals.length){
      rivals.push({
        icon:'🔥',
        title:'Keep pushing',
        sub:'Register more drivers and clients to enter the visible ranks.'
      });
    }

    el.innerHTML = rivals.map(r => `
      <div class="rival-box">
        <div class="row">
          <div class="pulse-dot"></div>
          <div class="stack">
            <div class="title">${esc(r.title)}</div>
            <div class="sub">${esc(r.sub)}</div>
          </div>
        </div>
        <div>${esc(r.icon)}</div>
      </div>
    `).join('');
  }

  function fillBadges(driverRows, clientRows, myName){
    const el = document.getElementById('achievementGrid');
    if(!el) return;

    const dIdx = driverRows.findIndex(r => nameOf(r).trim().toLowerCase() === myName);
    const cIdx = clientRows.findIndex(r => nameOf(r).trim().toLowerCase() === myName);
    const dVal = dIdx >= 0 ? countOf(driverRows[dIdx]) : 0;
    const cVal = cIdx >= 0 ? countOf(clientRows[cIdx]) : 0;

    const badges = [
      {icon:'🏁', title:'First Driver', sub:'Register your first driver', on:(dVal >= 1)},
      {icon:'🔥', title:'10 Clients', sub:'Reach 10 total clients', on:(cVal >= 10)},
      {icon:'🚘', title:'50 Drivers', sub:'Reach 50 total drivers', on:(dVal >= 50)},
      {icon:'👑', title:'Top 3', sub:'Enter top 3 on any leaderboard', on:((dIdx >= 0 && dIdx <= 2) || (cIdx >= 0 && cIdx <= 2))}
    ];

    el.innerHTML = badges.map(b => `
      <div class="achievement ${b.on ? '' : 'locked'}">
        <div class="a-ico">${b.icon}</div>
        <div class="title">${esc(b.title)}</div>
        <div class="sub">${esc(b.sub)}</div>
      </div>
    `).join('');
  }

  async function loadLeaderboardOverride(){
    try{
      const period = getPeriod();
      const controller = new AbortController();
      const timer = setTimeout(() => controller.abort(), 15000);
      const res = await fetch('/api/agent/leaderboard_v4?period=' + encodeURIComponent(period), {
        credentials: 'same-origin',
        signal: controller.signal
      }).finally(() => clearTimeout(timer));
      if(!res.ok) throw new Error('Leaderboard request failed: ' + res.status);
      const data = await res.json();

      const driverRows = Array.isArray(data.top_driver_recruiters) ? data.top_driver_recruiters : [];
      const clientRows = Array.isArray(data.top_client_recruiters) ? data.top_client_recruiters : [];
      const myName = getAgentName();

      fillTable('driverLeaderTable', driverRows, 'driver');
      fillTable('clientLeaderTable', clientRows, 'client');

      fillRank(driverRows, myName, 'rankDriversWeek', 'rankDriversWeekSub', 'drivers');
      fillRank(clientRows, myName, 'rankClientsWeek', 'rankClientsWeekSub', 'clients');

      const periodLabel = period === 'month' ? 'Month' : (period === 'all' ? 'All Time' : 'Week');
      const lbl = document.getElementById('leaderboardPeriodLabel');
      const allTime = document.getElementById('rankAllTime');
      const allTimeSub = document.getElementById('rankAllTimeSub');
      if(lbl) lbl.textContent = periodLabel;
      if(allTime) allTime.textContent = periodLabel;
      if(allTimeSub) allTimeSub.textContent = 'Live recruiter comparison';

      const myDriverRow = driverRows.find(r => nameOf(r).trim().toLowerCase() === myName);
      const myClientRow = clientRows.find(r => nameOf(r).trim().toLowerCase() === myName);
      const myDrivers = myDriverRow ? countOf(myDriverRow) : 0;
      const myClients = myClientRow ? countOf(myClientRow) : 0;

      setProgress('compDrivers50', 'barDrivers50', myDrivers, 50);
      setProgress('compActivatedDrivers50', 'barActivatedDrivers50', myDrivers, 50);
      setProgress('compActivatedClients150', 'barActivatedClients150', myClients, 150);

      fillCompetition('closeDrivers50', driverRows, 50, 'Closest by driver registrations');
      fillCompetition('closeActivatedDrivers50', driverRows, 50, 'Closest by driver count');
      fillCompetition('closeActivatedClients150', clientRows, 150, 'Closest by client count');

      fillRivals(driverRows, clientRows, myName);
      fillBadges(driverRows, clientRows, myName);
      if(window.patchOverviewFromLeaderboard) window.patchOverviewFromLeaderboard();

      console.log('leaderboard override loaded', {
        period,
        drivers: driverRows.length,
        clients: clientRows.length,
        myName
      });
    }catch(e){
      console.error('leaderboard override failed', e);
    }
  }

  window.loadLeaderboardOverride = loadLeaderboardOverride;
})();
</script>

<script>
(function(){
  function num(v){ return Number(v || 0); }

  function patchOverviewFromLeaderboard(){
    try{
      const driverBody = document.getElementById('driverLeaderTable');
      const clientBody = document.getElementById('clientLeaderTable');
      const hero = document.getElementById('heroTitle');
      if(!driverBody || !clientBody || !hero) return;

      const myName = (hero.textContent || '').replace(/^Welcome,\s*/i, '').trim().toLowerCase();

      function findMyCount(tbody){
        const rows = Array.from(tbody.querySelectorAll('tr'));
        for(const tr of rows){
          const tds = tr.querySelectorAll('td');
          if(tds.length < 4) continue;
          const name = (tds[1].textContent || '').trim().toLowerCase();
          const count = parseInt((tds[2].textContent || '0').trim(), 10) || 0;
          if(name === myName) return count;
        }
        return 0;
      }

      const myDrivers = findMyCount(driverBody);
      const myClients = findMyCount(clientBody);

      const heroDrivers = document.getElementById('heroDrivers');
      const heroClients = document.getElementById('heroClients');

      if(heroDrivers && num(heroDrivers.textContent) === 0 && myDrivers > 0){
        heroDrivers.textContent = String(myDrivers);
