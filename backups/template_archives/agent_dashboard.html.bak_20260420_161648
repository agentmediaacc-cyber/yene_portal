    function buildCharts(rows){
      const trend = $("trendChart");
      const counts = {};
      let drivers = 0, clients = 0, today = 0;

      const todayStr = new Date().toDateString();

      rows.forEach(r => {
        const d = new Date(r.created_at || Date.now());
        const day = isNaN(d.getTime()) ? "Unknown" : d.toLocaleDateString(undefined, {month:"short", day:"numeric"});
        counts[day] = (counts[day] || 0) + 1;
        const type = String(r.subject_type || r.type || "").toLowerCase();
        if(type === "driver") drivers++;
        if(type === "client") clients++;
        if(!isNaN(d.getTime()) && d.toDateString() === todayStr) today++;
      });

      const entries = Object.entries(counts).slice(-7);
      const max = Math.max(1, ...entries.map(([,v]) => v));

      trend.innerHTML = entries.length ? entries.map(([k,v]) => `
        <div class="bar-col">
          <div class="bar-value">${v}</div>
          <div class="bar" style="height:${Math.max(12, (v/max)*220)}px"></div>
          <div class="bar-label">${esc(k)}</div>
        </div>
      `).join("") : '<div class="muted">No chart data yet.</div>';

      setTextSafe("mixDrivers", drivers;
      setTextSafe("mixClients", clients;
      setTextSafe("mixToday", today;
      setTextSafe("mixTotal", rows.length;
    }

