      if(heroClients && num(heroClients.textContent) === 0 && myClients > 0){
        heroClients.textContent = String(myClients);
      }
    }catch(e){
      console.error('patchOverviewFromLeaderboard failed', e);
    }
  }

  window.patchOverviewFromLeaderboard = patchOverviewFromLeaderboard;
  setTimeout(patchOverviewFromLeaderboard, 500);
  setTimeout(patchOverviewFromLeaderboard, 1200);
})();
