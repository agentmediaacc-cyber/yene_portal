<script>
(function(){
  let supportFilter = 'all';
  let supportRows = [];

  function esc(v){
    return String(v ?? "")
      .replace(/&/g,"&amp;")
      .replace(/</g,"&lt;")
      .replace(/>/g,"&gt;")
      .replace(/"/g,"&quot;");
  }

  function shortDate(v){
    if(!v) return '-';
    const d = new Date(v);
    if(isNaN(d.getTime())) return String(v);
    return d.toLocaleString();
  }

  async function supportGet(url, opts={}){
    const timeoutMs = opts.timeoutMs || 15000;
    const controller = new AbortController();
    const timer = setTimeout(() => controller.abort(), timeoutMs);
    const fetchOpts = {...opts};
    delete fetchOpts.timeoutMs;
    const r = await fetch(url, {credentials:'same-origin', signal:controller.signal, ...fetchOpts}).finally(() => clearTimeout(timer));
    const txt = await r.text();
    let data = {};
    try{ data = txt ? JSON.parse(txt) : {}; }catch(_){}
    if(!r.ok){
      throw new Error(data.error || data.message || txt || ('Request failed: ' + r.status));
    }
    return data;
  }

  function classifyMessage(row){
    const subject = String(row.subject || '').toUpperCase();
    if(subject.includes('[AGENT]') || subject.includes('SUPPORT')) return 'support';
    return 'system';
  }

  function whoSent(row){
    const subject = String(row.subject || '').toUpperCase();
    if(subject.includes('[AGENT]')) return 'agent';
    if(subject.includes('[ADMIN_REPLY]')) return 'admin';
    return 'admin';
  }

  function filteredRows(){
    const rows = Array.isArray(supportRows) ? supportRows : [];
    if(supportFilter === 'all') return rows;
    if(supportFilter === 'unread') return rows.filter(r => String(r.status || '').toUpperCase() !== 'READ');
    if(supportFilter === 'support') return rows.filter(r => classifyMessage(r) === 'support');
    if(supportFilter === 'system') return rows.filter(r => classifyMessage(r) === 'system');
    return rows;
  }

  function updateSummary(summary){
    const s = summary || {};
    const set = (id, v) => { const el = document.getElementById(id); if(el) el.textContent = String(v || 0); };
    set('supportTotal', s.total || 0);
    set('supportUnread', s.unread || 0);
    set('supportSupport', s.support || 0);
    set('supportSystem', s.system || 0);
  }

  function renderSupportRows(){
    const box = document.getElementById('fullMessageList');
    const inboxMeta = document.getElementById('inboxMeta');
    if(!box) return;

    const rows = filteredRows();
    if(inboxMeta) inboxMeta.textContent = rows.length + ' messages';

    if(!rows.length){
      box.innerHTML = '<div class="muted">No messages in this filter.</div>';
      return;
    }

    box.innerHTML = rows.map(r => {
      const sender = whoSent(r);
      const msgType = classifyMessage(r);
      const isRead = String(r.status || '').toUpperCase() === 'READ';
      return `
        <div class="msg-card ${sender}">
          <div class="msg-meta">
            <div>
              <div class="title">${esc(r.subject || 'Message')}</div>
              <div class="sub">${esc(shortDate(r.created_at))}</div>
            </div>
            <div class="msg-badges">
              <span class="msg-badge">${esc(sender.toUpperCase())}</span>
              <span class="msg-badge">${esc(msgType.toUpperCase())}</span>
              <span class="msg-badge">${esc((r.status || 'OPEN').toUpperCase())}</span>
            </div>
          </div>

          <div class="sub" style="white-space:pre-wrap">${esc(r.message || '')}</div>

          <div class="reply-actions">
            ${!isRead ? `<button class="btn btn-soft" onclick="window.markSupportRead('${esc(r.id || '')}')">Mark Read</button>` : ''}
            <button class="btn btn-soft" onclick="window.replySupportMsg('${esc(r.id || '')}', '${esc((r.subject || '').replace(/'/g, '&#39;'))}')">Reply</button>
          </div>
        </div>
      `;
    }).join('');
  }

  async function loadSupportSummary(){
    try{
      const data = await supportGet('/api/agent/messages/summary');
      updateSummary(data.summary || {});
    }catch(e){
      console.error('support summary failed', e);
    }
  }

  async function loadSupportInbox(){
    try{
      const data = await supportGet('/api/agent/messages');
      supportRows = Array.isArray(data.rows) ? data.rows : [];
      renderSupportRows();
    }catch(e){
      console.error('support inbox failed', e);
      const box = document.getElementById('fullMessageList');
      if(box) box.innerHTML = '<div class="muted">Could not load support inbox.</div>';
    }
  }

  async function refreshSupport(){
    await Promise.allSettled([loadSupportSummary(), loadSupportInbox()]);
  }

  window.markSupportRead = async function(messageId){
    try{
      await supportGet('/api/agent/messages/' + encodeURIComponent(messageId) + '/read', {
        method:'POST'
      });
      await refreshSupport();
    }catch(e){
      alert(e.message);
    }
  };

  window.replySupportMsg = function(messageId, subject){
    const replyId = document.getElementById('supportReplyToId');
    const sub = document.getElementById('supportSubject');
    const hint = document.getElementById('supportReplyHint');
    if(replyId) replyId.value = messageId;
    if(sub && !sub.value.trim()) sub.value = 'Re: ' + subject.replace(/^Re:\s*/i, '');
    if(hint) hint.textContent = 'Replying to message #' + messageId;
    const msg = document.getElementById('supportMessage');
    if(msg) msg.focus();
  };

  async function sendSupportMessage(ev){
    ev.preventDefault();
    const category = document.getElementById('supportCategory');
    const priority = document.getElementById('supportPriority');
    const subject = document.getElementById('supportSubject');
    const message = document.getElementById('supportMessage');
    const replyTo = document.getElementById('supportReplyToId');
    const hint = document.getElementById('supportReplyHint');

    const payload = {
      category: category ? category.value : 'General',
      priority: priority ? priority.value : 'NORMAL',
      subject: subject ? subject.value.trim() : '',
      message: message ? message.value.trim() : '',
      reply_to_id: replyTo ? replyTo.value : ''
    };

    try{
      await supportGet('/api/agent/messages/send', {
        method:'POST',
        headers:{'Content-Type':'application/json'},
        body: JSON.stringify(payload)
      });

      if(subject) subject.value = '';
      if(message) message.value = '';
      if(replyTo) replyTo.value = '';
      if(hint) hint.textContent = 'New support message.';
      await refreshSupport();
    }catch(e){
      alert(e.message);
    }
  }

  function bindSupportTabs(){
    document.querySelectorAll('[data-support-filter]').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('[data-support-filter]').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        supportFilter = btn.dataset.supportFilter || 'all';
        renderSupportRows();
      });
    });
  }

  function bindSupportForm(){
    const form = document.getElementById('supportForm');
    const clearBtn = document.getElementById('supportClearReply');
    const hint = document.getElementById('supportReplyHint');
    const replyTo = document.getElementById('supportReplyToId');

    if(form) form.addEventListener('submit', sendSupportMessage);
    if(clearBtn){
      clearBtn.addEventListener('click', () => {
        if(replyTo) replyTo.value = '';
        if(hint) hint.textContent = 'New support message.';
      });
    }
  }

  document.addEventListener('DOMContentLoaded', function(){
    bindSupportTabs();
    bindSupportForm();
    setTimeout(refreshSupport, 400);

  });
})();
</script>
