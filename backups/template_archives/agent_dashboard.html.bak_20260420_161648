    function forceRenderCompetitionCards(){
      const myName = String(
        (state.me && (state.me.full_name || state.me.name || state.me.username)) || ''
      ).trim().toLowerCase();

      const drivers = Array.isArray(state.leaderboardDrivers) ? state.leaderboardDrivers : [];
      const clients = Array.isArray(state.leaderboardClients) ? state.leaderboardClients : [];

      function getName(r){
        return String(r.agent_name || r.full_name || r.name || r.agent || 'Agent').trim();
      }
      function getCount(r){
        return Number(r.count || r.total || r.clients_registered || r.drivers_registered || 0);
      }

      const myDriver = drivers.find(r => getName(r).toLowerCase() === myName);
      const myClient = clients.find(r => getName(r).toLowerCase() === myName);

      const myDrivers = myDriver ? getCount(myDriver) : 0;
      const myClients = myClient ? getCount(myClient) : 0;

      document.getElementById('compDrivers50').textContent = `${myDrivers} / 50`;
      document.getElementById('compActivatedDrivers50').textContent = `${myDrivers} / 50`;
      document.getElementById('compActivatedClients150').textContent = `${myClients} / 150`;

      function setBar(id, value, target){
        const el = document.getElementById(id);
        if(!el) return;
        const pct = Math.max(0, Math.min(100, (value / target) * 100));
        el.style.width = pct + '%';
      }

      setBar('barDrivers50', myDrivers, 50);
      setBar('barActivatedDrivers50', myDrivers, 50);
      setBar('barActivatedClients150', myClients, 150);

      function fillList(elId, rows, target, label){
        const el = document.getElementById(elId);
        if(!el) return;
        const ranked = [...rows].filter(r => getCount(r) > 0).sort((a,b) => getCount(b) - getCount(a)).slice(0,3);
        if(!ranked.length){
          el.innerHTML = '<div class="muted">Your progress will grow as you add more registrations.</div>';
          return;
        }
        el.innerHTML = ranked.map((r, i) => {
          const v = getCount(r);
          const left = Math.max(0, target - v);
          return `
            <div class="list-item">
              <div class="stack">
                <div class="title">#${i+1} ${esc(getName(r))}</div>
                <div class="sub">${label} • ${v}/${target} • ${left} left</div>
              </div>
            </div>
          `;
        }).join('');
      }

      fillList('closeDrivers50', drivers, 50, 'Closest by driver registrations');
      fillList('closeActivatedDrivers50', drivers, 50, 'Closest by driver count');
      fillList('closeActivatedClients150', clients, 150, 'Closest by client count');
    }

    function renderLeaderboard(){
      const driverRows = Array.isArray(state.leaderboardDrivers) ? state.leaderboardDrivers : [];
      const clientRows = Array.isArray(state.leaderboardClients) ? state.leaderboardClients : [];
      const me = state.me || {};
      const myName = String(me.full_name || me.name || me.username || '').trim().toLowerCase();
      const periodLabel = state.leaderboardPeriod === 'month' ? 'Month' : (state.leaderboardPeriod === 'all' ? 'All Time' : 'Week');
      const leaderboardError = state.leaderboardError || "";

      $('leaderboardPeriodLabel').textContent = periodLabel;

      function getName(r){
        return String(r.agent_name || r.full_name || r.name || r.agent || 'Agent');
      }
      function getCount(r){
        return Number(r.count || r.total || 0);
      }
      function getTown(r){
        return String(r.town || r.top_town || '—');
      }

      const dBody = $('driverLeaderTable');
      const cBody = $('clientLeaderTable');

      if(!driverRows.length){
        dBody.innerHTML = `<tr><td colspan="4" class="muted">${leaderboardError ? esc(leaderboardError) : 'No driver leaderboard data yet.'}</td></tr>`;
      } else {
        dBody.innerHTML = driverRows.map((r, i) => `
          <tr>
            <td>${i+1}</td>
            <td>${esc(getName(r))}</td>
            <td>${getCount(r)}</td>
            <td>${esc(getTown(r))}</td>
          </tr>
        `).join('');
      }

      if(!clientRows.length){
        cBody.innerHTML = `<tr><td colspan="4" class="muted">${leaderboardError ? esc(leaderboardError) : 'No client leaderboard data yet.'}</td></tr>`;
      } else {
        cBody.innerHTML = clientRows.map((r, i) => `
          <tr>
            <td>${i+1}</td>
            <td>${esc(getName(r))}</td>
            <td>${getCount(r)}</td>
            <td>${esc(getTown(r))}</td>
          </tr>
        `).join('');
      }

      const myDriverRank = driverRows.findIndex(r => getName(r).trim().toLowerCase() === myName);
      const myClientRank = clientRows.findIndex(r => getName(r).trim().toLowerCase() === myName);

      const myDriverValue = myDriverRank >= 0 ? getCount(driverRows[myDriverRank]) : 0;
      const myClientValue = myClientRank >= 0 ? getCount(clientRows[myClientRank]) : 0;

      $('rankDriversWeek').textContent = myDriverRank >= 0 ? '#' + (myDriverRank + 1) : '-';
      $('rankClientsWeek').textContent = myClientRank >= 0 ? '#' + (myClientRank + 1) : '-';
      $('rankAllTime').textContent = periodLabel;

      $('rankDriversWeekSub').textContent = myDriverRank >= 0
        ? `${myDriverValue} drivers in ${periodLabel.toLowerCase()}`
        : `No driver rank found yet`;
      $('rankClientsWeekSub').textContent = myClientRank >= 0
        ? `${myClientValue} clients in ${periodLabel.toLowerCase()}`
        : `No client rank found yet`;
      $('rankAllTimeSub').textContent = `Live recruiter comparison`;

      // Rival tracker
      const rival = document.getElementById('rivalTrackerList');
      const rivals = [];

      if(myDriverRank > 0){
        const ahead = driverRows[myDriverRank - 1];
        rivals.push({
          icon: '🚗',
          title: `Pass ${getName(ahead)} on drivers`,
          sub: `${Math.max(1, getCount(ahead) - myDriverValue)} more driver(s) to overtake`
        });
      }
      if(myClientRank > 0){
        const ahead = clientRows[myClientRank - 1];
        rivals.push({
          icon: '👤',
          title: `Pass ${getName(ahead)} on clients`,
          sub: `${Math.max(1, getCount(ahead) - myClientValue)} more client(s) to overtake`
        });
      }
      if(myClientRank >= 0 && myClientRank <= 2 || myDriverRank >= 0 && myDriverRank <= 2){
        rivals.push({
          icon: '👑',
          title: 'Top 3 energy',
          sub: 'You are already in a visible winning zone. Keep pushing.'
        });
      } else {
        rivals.push({
          icon: '🔥',
          title: 'Push for Top 3',
          sub: 'Today’s hustle can move your name up the board.'
        });
      }

      rival.innerHTML = rivals.map(r => `
        <div class="rival-box">
          <div class="row">
            <div class="pulse-dot"></div>
            <div class="stack">
              <div class="title">${esc(r.title)}</div>
              <div class="sub">${esc(r.sub)}</div>
            </div>
          </div>
          <div>${esc(r.icon)}</div>
        </div>
      `).join('');

      // Achievements
      const ach = document.getElementById('achievementGrid');
      const badges = [
        {icon:'🏁', title:'First Driver', sub:'Register your first driver', on:(myDriverValue >= 1)},
        {icon:'🔥', title:'10 Clients', sub:'Reach 10 total clients', on:(myClientValue >= 10)},
        {icon:'🚘', title:'50 Drivers', sub:'Reach 50 total drivers', on:(myDriverValue >= 50)},
        {icon:'👑', title:'Top 3', sub:'Enter top 3 on any leaderboard', on:((myDriverRank >= 0 && myDriverRank <= 2) || (myClientRank >= 0 && myClientRank <= 2))}
      ];
      ach.innerHTML = badges.map(b => `
        <div class="achievement ${b.on ? '' : 'locked'}">
          <div class="a-ico">${b.icon}</div>
          <div class="title">${esc(b.title)}</div>
          <div class="sub">${esc(b.sub)}</div>
        </div>
      `).join('');

      forceRenderCompetitionCards();
    }

