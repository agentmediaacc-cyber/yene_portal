    function deepFindArrays(obj, maxDepth=6, seen=new Set(), path='root'){
      const out = [];
      if(!obj || typeof obj !== 'object' || seen.has(obj) || maxDepth < 0) return out;
      seen.add(obj);

      if(Array.isArray(obj)){
        out.push({ path, value: obj });
        for(let i = 0; i < obj.length; i++){
          out.push(...deepFindArrays(obj[i], maxDepth - 1, seen, path + '[' + i + ']'));
        }
        return out;
      }

      for(const [k, v] of Object.entries(obj)){
        out.push(...deepFindArrays(v, maxDepth - 1, seen, path + '.' + k));
      }
      return out;
    }

    function pickLeaderboardArrays(payload){
      const arrays = deepFindArrays(payload);
      let driverRows = [];
      let clientRows = [];

      function scoreDriverArray(arr){
        if(!Array.isArray(arr) || !arr.length || typeof arr[0] !== 'object') return -1;
        let score = 0;
        const keys = Object.keys(arr[0] || {}).join(' ').toLowerCase();
        if(keys.includes('driver')) score += 4;
        if(keys.includes('agent')) score += 2;
        if(keys.includes('town')) score += 1;
        if(keys.includes('rank')) score += 1;
        return score;
      }

      function scoreClientArray(arr){
        if(!Array.isArray(arr) || !arr.length || typeof arr[0] !== 'object') return -1;
        let score = 0;
        const keys = Object.keys(arr[0] || {}).join(' ').toLowerCase();
        if(keys.includes('client')) score += 4;
        if(keys.includes('agent')) score += 2;
        if(keys.includes('town')) score += 1;
        if(keys.includes('rank')) score += 1;
        return score;
      }

      let bestDriver = {score:-1, arr:[]};
      let bestClient = {score:-1, arr:[]};

      arrays.forEach(({value}) => {
        const ds = scoreDriverArray(value);
        const cs = scoreClientArray(value);
        if(ds > bestDriver.score) bestDriver = {score: ds, arr: value};
        if(cs > bestClient.score) bestClient = {score: cs, arr: value};
      });

      driverRows = bestDriver.arr || [];
      clientRows = bestClient.arr || [];

      return { driverRows, clientRows };
    }

