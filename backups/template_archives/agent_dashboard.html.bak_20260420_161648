<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>YENE Agent Hub</title>
  <style>
    :root{
      --bg:#07111c;
      --bg-soft:#0c1727;
      --panel:rgba(11,20,34,.86);
      --panel-2:rgba(16,28,46,.94);
      --line:rgba(255,255,255,.08);
      --line-2:rgba(77,163,255,.22);
      --text:#eef5ff;
      --muted:#9db0cb;
      --primary:#4da3ff;
      --primary-2:#8ed0ff;
      --success:#2ccc8a;
      --warning:#f3b34d;
      --danger:#ff6a6a;
      --radius:22px;
      --radius-sm:16px;
      --shadow:0 20px 50px rgba(0,0,0,.35);
      --sidebar-w:280px;
      --topbar-h:76px;
    }

    *{box-sizing:border-box}
    html{scroll-behavior:smooth}
    body{
      margin:0;
      font-family:Inter,ui-sans-serif,system-ui,-apple-system,Segoe UI,Roboto,Arial,sans-serif;
      color:var(--text);
      background:
        radial-gradient(circle at top right, rgba(77,163,255,.18), transparent 24%),
        radial-gradient(circle at 10% 0%, rgba(142,208,255,.10), transparent 25%),
        linear-gradient(180deg,#07111c 0%,#0a1422 100%);
      min-height:100vh;
      overflow-x:hidden;
    }

    a{color:inherit;text-decoration:none}
    button,input,select,textarea{font:inherit}
    img{max-width:100%}
    .hidden{display:none!important}
    .muted{color:var(--muted)}
    .danger{color:#ffc6c6}
    .success{color:#b6ffd8}
    .warning{color:#ffe2a6}

    .app{
      display:grid;
      grid-template-columns:var(--sidebar-w) 1fr;
      min-height:100vh;
    }

    .sidebar{
      position:sticky;
      top:0;
      height:100vh;
      background:linear-gradient(180deg, rgba(5,12,22,.97), rgba(9,18,31,.95));
      border-right:1px solid var(--line);
      padding:18px;
      z-index:50;
      backdrop-filter:blur(18px);
    }

    .brand{
      display:flex;
      align-items:center;
      gap:14px;
      padding:14px;
      border:1px solid var(--line);
      border-radius:20px;
      background:rgba(255,255,255,.04);
      box-shadow:var(--shadow);
    }

    .logo{
      width:48px;height:48px;border-radius:16px;
      display:grid;place-items:center;
      font-weight:900;font-size:19px;
      background:linear-gradient(135deg,#4da3ff,#156cf3);
      color:#fff;
      box-shadow:0 12px 30px rgba(77,163,255,.35);
    }

    .brand h1{margin:0;font-size:18px;line-height:1.1}
    .brand p{margin:4px 0 0;color:var(--muted);font-size:12px}

    .side-stack{margin-top:18px;display:flex;flex-direction:column;gap:10px}

    .nav-btn{
      width:100%;
      display:flex;
      align-items:center;
      gap:12px;
      padding:14px 14px;
      border-radius:16px;
      border:1px solid transparent;
      background:rgba(255,255,255,.03);
      color:var(--text);
      cursor:pointer;
      transition:.18s ease;
      text-align:left;
      position:relative;
      overflow:hidden;
    }

    .nav-btn:hover,.nav-btn.active{
      transform:translateY(-1px);
      background:rgba(77,163,255,.12);
      border-color:var(--line-2);
    }

    .nav-btn::after{
      content:"";
      position:absolute;
      inset:auto auto 0 0;
      height:2px;width:0;
      background:linear-gradient(90deg,var(--primary),transparent);
      transition:.2s ease;
    }
    .nav-btn:hover::after,.nav-btn.active::after{width:100%}

    .nav-ico{
      width:20px;height:20px;display:grid;place-items:center;flex:0 0 20px
    }

    .side-footer{
      position:absolute;left:18px;right:18px;bottom:18px;
      padding:14px;border-radius:18px;border:1px solid var(--line);
      background:rgba(255,255,255,.03);color:var(--muted);font-size:13px;
    }

    .main{min-width:0}

    .topbar{
      position:sticky;top:0;z-index:40;
      height:var(--topbar-h);
      display:flex;align-items:center;justify-content:space-between;gap:12px;
      padding:16px 24px;
      border-bottom:1px solid var(--line);
      background:rgba(7,17,28,.72);
      backdrop-filter:blur(18px);
    }

    .top-left,.top-right{display:flex;align-items:center;gap:10px}
    .menu-btn,.icon-btn{
      width:46px;height:46px;border-radius:14px;
      border:1px solid var(--line);
      background:rgba(255,255,255,.05);
      color:var(--text);cursor:pointer;
      display:grid;place-items:center;
      transition:.18s ease;
    }
    .menu-btn:hover,.icon-btn:hover{transform:translateY(-1px);border-color:var(--line-2)}
    .menu-btn{display:none}
    .menu-backdrop{
      position:fixed;
      inset:0;
      z-index:45;
      background:rgba(0,0,0,.48);
      opacity:0;
      pointer-events:none;
      transition:opacity .2s ease;
      backdrop-filter:blur(3px);
    }
    .menu-backdrop.show{opacity:1;pointer-events:auto}
    .sidebar-close{
      display:none;
      width:42px;height:42px;border-radius:14px;
      border:1px solid var(--line);
      background:rgba(255,255,255,.05);
      color:var(--text);
      cursor:pointer;
      place-items:center;
      margin-left:auto;
      margin-bottom:12px;
    }
    body.menu-open{overflow:hidden}

    .soft-badge{
      padding:10px 12px;border-radius:999px;
      background:rgba(255,255,255,.05);
      border:1px solid var(--line);
      color:var(--muted);font-size:13px;
    }

    .btn{
      border:none;cursor:pointer;
      padding:11px 16px;border-radius:14px;font-weight:800;
      transition:.18s ease;
    }
    .btn:hover{transform:translateY(-1px)}
    .btn-primary{background:linear-gradient(135deg,var(--primary),#176ef3);color:#fff}
    .btn-soft{background:rgba(255,255,255,.05);color:var(--text);border:1px solid var(--line)}
    .btn-danger{background:rgba(255,106,106,.12);color:#ffd4d4;border:1px solid rgba(255,106,106,.18)}

    .page{
      padding:24px;
      display:flex;flex-direction:column;gap:20px;
    }

    .hero{
      border:1px solid var(--line);
      border-radius:28px;
      padding:26px;
      background:
        radial-gradient(circle at top right, rgba(77,163,255,.16), transparent 28%),
        linear-gradient(135deg, rgba(255,255,255,.05), rgba(255,255,255,.02));
      box-shadow:var(--shadow);
      overflow:hidden;
      position:relative;
    }

    .hero-grid{
      display:grid;
      grid-template-columns:1.45fr .95fr;
      gap:18px;
      align-items:stretch;
    }

    .eyebrow{
      color:var(--primary-2);
      text-transform:uppercase;
      letter-spacing:.16em;
      font-size:12px;
      font-weight:900;
    }

    .hero h2{
      margin:10px 0 8px;
      font-size:clamp(28px,4vw,46px);
      line-height:1.02;
    }

    .hero p{margin:0;color:var(--muted);max-width:760px;line-height:1.65}

    .chips{display:flex;flex-wrap:wrap;gap:10px;margin-top:18px}
    .chip{
      padding:10px 12px;border-radius:999px;
      background:rgba(255,255,255,.05);
      border:1px solid var(--line);
      font-size:13px;color:#dceaff;
    }

    .hero-side{
      border:1px solid var(--line);
      border-radius:22px;
      padding:18px;
      background:rgba(255,255,255,.04);
      display:flex;flex-direction:column;justify-content:space-between;gap:12px;
    }

    .label{
      color:var(--muted);font-size:12px;text-transform:uppercase;letter-spacing:.12em;font-weight:800;
    }

    .amount{
      font-size:36px;font-weight:900;letter-spacing:.3px
    }

    .grid-4,.grid-3,.grid-2{
      display:grid;gap:16px;
    }
    .grid-4{grid-template-columns:repeat(4,minmax(0,1fr))}
    .grid-3{grid-template-columns:repeat(3,minmax(0,1fr))}
    .grid-2{grid-template-columns:repeat(2,minmax(0,1fr))}

    .card{
      border:1px solid var(--line);
      background:var(--panel);
      border-radius:22px;
      box-shadow:var(--shadow);
      backdrop-filter:blur(15px);
      min-width:0;
      overflow:hidden;
    }

    .card-header{
      display:flex;align-items:center;justify-content:space-between;gap:12px;
      padding:18px 18px 0;
    }
    .card-header h3{margin:0;font-size:17px}
    .card-body{padding:18px}
    .card-body.tight{padding-top:10px}

    .stat{
      padding:18px;
      display:flex;flex-direction:column;gap:12px;
    }
    .stat-top{
      display:flex;align-items:center;justify-content:space-between;gap:10px;
    }
    .stat-ico{
      width:42px;height:42px;border-radius:14px;
      display:grid;place-items:center;
      background:rgba(77,163,255,.12);
      color:#bfe0ff;
      border:1px solid rgba(77,163,255,.18);
    }
    .stat-value{font-size:30px;font-weight:900}
    .stat-sub{font-size:13px;color:var(--muted)}

    .section{display:none}
    .section.active{display:block}

    .list{
      display:flex;flex-direction:column;gap:12px
    }

    .list-item{
      border:1px solid var(--line);
      background:rgba(255,255,255,.03);
      border-radius:18px;
      padding:14px;
      display:flex;
      align-items:flex-start;
      justify-content:space-between;
      gap:12px;
      transition:.18s ease;
    }
    .list-item:hover{
      transform:translateY(-1px);
      border-color:var(--line-2);
      background:rgba(255,255,255,.045);
    }

    .avatar{
      width:42px;height:42px;border-radius:14px;
      display:grid;place-items:center;
      background:linear-gradient(135deg,#153050,#214e7d);
      color:#d7e9ff;font-weight:900;flex:0 0 42px;
      border:1px solid rgba(255,255,255,.08);
    }

    .row{
      display:flex;align-items:center;gap:12px;min-width:0
    }

    .stack{display:flex;flex-direction:column;gap:5px;min-width:0}
    .title{
      font-weight:800;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;
    }
    .sub{
      color:var(--muted);font-size:13px;line-height:1.45
    }

    .pill{
      padding:8px 10px;border-radius:999px;font-size:12px;font-weight:800;
      border:1px solid var(--line);background:rgba(255,255,255,.05);
      white-space:nowrap;
    }

    .toolbar{
      display:flex;flex-wrap:wrap;gap:10px;align-items:center
    }

    .field,.select,.textarea{
      width:100%;
      border-radius:14px;
      border:1px solid var(--line);
      background:rgba(255,255,255,.04);
      color:var(--text);
      padding:12px 14px;
      outline:none;
    }
    .textarea{min-height:110px;resize:vertical}

    .form-grid{
      display:grid;gap:12px;
      grid-template-columns:repeat(2,minmax(0,1fr));
    }

    .full{grid-column:1/-1}

    .mini-grid{
      display:grid;
      grid-template-columns:repeat(3,minmax(0,1fr));
      gap:10px;
    }

    .metric-box{
      border:1px solid var(--line);
      border-radius:16px;
      padding:14px;
      background:rgba(255,255,255,.03);
    }
    .metric-box .k{font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:.12em;font-weight:800}
    .metric-box .v{font-size:22px;font-weight:900;margin-top:8px}

    .chart-wrap{
      height:320px;
      display:flex;
      align-items:flex-end;
      gap:10px;
      padding:10px 0 4px;
    }

    .bar-col{
      flex:1;
      display:flex;
      flex-direction:column;
      justify-content:flex-end;
      align-items:center;
      gap:8px;
      min-width:0;
    }

    .bar{
      width:100%;
      max-width:54px;
      border-radius:16px 16px 10px 10px;
      background:linear-gradient(180deg,#7fcbff,#2f8fff);
      box-shadow:0 10px 24px rgba(77,163,255,.22);
      min-height:10px;
      position:relative;
      overflow:hidden;
    }

    .bar::after{
      content:"";
      position:absolute;inset:0;
      background:linear-gradient(180deg,rgba(255,255,255,.22),transparent 40%);
    }

    .bar-label{
      font-size:12px;color:var(--muted);
      text-align:center;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;
      width:100%;
    }

    .bar-value{
      font-size:12px;font-weight:800;color:#dceaff;
    }

    .ring{
      width:170px;height:170px;border-radius:50%;
      background:conic-gradient(#4da3ff 0 58%, #2ccc8a 58% 82%, #f3b34d 82% 100%);
      display:grid;place-items:center;
      margin:auto;
      box-shadow:0 16px 35px rgba(0,0,0,.28);
    }

    .ring::before{
      content:"";
      width:108px;height:108px;border-radius:50%;
      background:#0b1728;
      border:1px solid var(--line);
      display:block;
    }

    .ring-center{
      position:absolute;
      text-align:center;
      width:110px;
    }

    .table-wrap{overflow:auto;border-radius:18px;border:1px solid var(--line)}
    table{width:100%;border-collapse:collapse;background:rgba(255,255,255,.03)}
    th,td{padding:13px 14px;border-bottom:1px solid var(--line);text-align:left;font-size:14px}
    th{color:#dbe9ff;background:rgba(255,255,255,.04);position:sticky;top:0}
    tr:hover td{background:rgba(255,255,255,.03)}

    .toast{
      position:fixed;right:18px;bottom:18px;z-index:1000;
      min-width:220px;max-width:360px;
      background:rgba(12,22,38,.96);
      border:1px solid var(--line-2);
      border-radius:18px;padding:14px 16px;box-shadow:var(--shadow);
      transform:translateY(20px);opacity:0;pointer-events:none;transition:.22s ease;
    }
    .toast.show{transform:translateY(0);opacity:1}

    .spark{
      position:relative;
      overflow:hidden;
    }
    .spark::before{
      content:"";
      position:absolute;
      inset:-20%;
      background:linear-gradient(120deg, transparent 30%, rgba(255,255,255,.12), transparent 70%);
      transform:translateX(-120%);
      animation:sweep 3.2s linear infinite;
      pointer-events:none;
    }
    @keyframes sweep{
      to{transform:translateX(120%)}
    }

    .loader{
      width:18px;height:18px;border-radius:50%;
      border:2px solid rgba(255,255,255,.18);
      border-top-color:#8ed0ff;
      animation:spin 1s linear infinite;
      display:inline-block;vertical-align:middle;
    }
    @keyframes spin{to{transform:rotate(360deg)}}

    .marketing-grid{
      display:grid;gap:14px;
      grid-template-columns:repeat(3,minmax(0,1fr));
    }

    .flyer-card{
      border:1px solid var(--line);
      border-radius:18px;
      overflow:hidden;
      background:rgba(255,255,255,.03);
    }

    .flyer-preview{
      min-height:220px;
      padding:18px;
      background:
        linear-gradient(180deg, rgba(6,17,30,.35), rgba(6,17,30,.75)),
        radial-gradient(circle at top right, rgba(77,163,255,.28), transparent 28%),
        linear-gradient(135deg,#12345d,#0b1728 70%);
      display:flex;
      flex-direction:column;
      justify-content:space-between;
    }

    .flyer-tag{
      align-self:flex-start;
      border:1px solid rgba(255,255,255,.18);
      color:#fff;background:rgba(255,255,255,.08);
      padding:8px 10px;border-radius:999px;font-size:11px;font-weight:900;letter-spacing:.08em;text-transform:uppercase;
    }

    .flyer-title{
      font-size:28px;font-weight:900;line-height:1.02;margin:0;
    }

    .flyer-sub{color:#d9eaff;line-height:1.5;margin-top:8px;font-size:14px}

    .flyer-footer{
      display:flex;justify-content:space-between;align-items:center;gap:12px;
      padding:14px 16px;
      border-top:1px solid var(--line);
    }

    .mini-note{
      font-size:12px;color:var(--muted)
    }

    .progress-wrap{
      margin-top:12px;
      height:14px;
      border-radius:999px;
      background:rgba(255,255,255,.06);
      border:1px solid var(--line);
      overflow:hidden;
      position:relative;
    }

    .progress-bar{
      height:100%;
      width:0%;
      border-radius:999px;
      background:linear-gradient(90deg,#4da3ff,#8ed0ff);
      transition:width .8s ease;
      box-shadow:0 0 18px rgba(77,163,255,.28);
    }

    .badge-grid{
      display:grid;
      grid-template-columns:repeat(4,minmax(0,1fr));
      gap:12px;
    }

    .achievement{
      border:1px solid var(--line);
      border-radius:18px;
      padding:14px;
      background:rgba(255,255,255,.03);
      min-width:0;
    }

    .achievement.locked{
      opacity:.65;
      filter:saturate(.65);
    }

    .achievement .a-ico{
      width:44px;height:44px;border-radius:14px;
      display:grid;place-items:center;
      background:rgba(77,163,255,.12);
      border:1px solid rgba(77,163,255,.18);
      margin-bottom:10px;
      font-size:20px;
    }

    .rival-box{
      border:1px solid var(--line);
      border-radius:18px;
      padding:14px;
      background:rgba(255,255,255,.03);
      display:flex;
      justify-content:space-between;
      gap:12px;
      align-items:center;
    }

    .leaderboard-stack{
      display:grid;
      grid-template-columns:1.2fr .8fr;
      gap:16px;
      align-items:start;
    }

    .leaderboard-panels{
      display:grid;
      grid-template-columns:1fr 1fr;
      gap:16px;
    }

    .leaderboard-side{
      display:flex;
      flex-direction:column;
      gap:16px;
      min-width:0;
    }

    .compact-list .list-item{
      padding:12px;
      border-radius:16px;
    }

    .compact-table th,.compact-table td{
      padding:11px 12px;
      font-size:13px;
    }

    .leader-topbar{
      display:flex;
      justify-content:space-between;
      align-items:center;
      gap:12px;
      flex-wrap:wrap;
    }

    .leader-subnote{
      color:var(--muted);
      font-size:12px;
      line-height:1.5;
    }

    .metric-hero{
      display:grid;
      grid-template-columns:repeat(3,minmax(0,1fr));
      gap:12px;
    }

    .metric-pill{
      border:1px solid var(--line);
      border-radius:16px;
      padding:12px;
      background:rgba(255,255,255,.03);
    }

    .metric-pill .k{
      font-size:11px;
      color:var(--muted);
      text-transform:uppercase;
      letter-spacing:.12em;
      font-weight:800;
    }

    .metric-pill .v{
      font-size:24px;
      font-weight:900;
      margin-top:8px;
    }

    @media (max-width: 1100px){
      .leaderboard-stack{
        grid-template-columns:1fr;
      }
    }

    @media (max-width: 800px){
      .leaderboard-panels{
        grid-template-columns:1fr;
      }
      .metric-hero{
        grid-template-columns:1fr;
      }
      .compact-table th,.compact-table td{
        padding:10px 10px;
        font-size:12px;
      }
      .rival-box{
        align-items:flex-start;
      }
    }

    .pulse-dot{
      width:10px;height:10px;border-radius:50%;
      background:#2ccc8a;
      box-shadow:0 0 0 rgba(44,204,138,.5);
      animation:pulseDot 1.6s infinite;
      flex:0 0 10px;
    }

    .support-shell{
      display:grid;
      grid-template-columns:1.1fr .9fr;
      gap:16px;
    }

    .support-tabs{
      display:flex;
      flex-wrap:wrap;
      gap:10px;
      margin-bottom:14px;
    }

    .support-tab{
      border:1px solid var(--line);
      background:rgba(255,255,255,.04);
      color:var(--text);
      padding:10px 12px;
      border-radius:999px;
      cursor:pointer;
      font-weight:800;
    }

    .support-tab.active{
      background:rgba(77,163,255,.14);
      border-color:rgba(77,163,255,.28);
    }

    .support-thread{
      display:flex;
      flex-direction:column;
      gap:12px;
      max-height:560px;
      overflow:auto;
      padding-right:4px;
    }

    .msg-card{
      border:1px solid var(--line);
      border-radius:18px;
      background:rgba(255,255,255,.03);
      padding:14px;
    }

    .msg-card.agent{
      border-color:rgba(44,204,138,.20);
      background:rgba(44,204,138,.06);
    }

    .msg-card.admin{
      border-color:rgba(77,163,255,.20);
      background:rgba(77,163,255,.06);
    }

    .msg-meta{
      display:flex;
      justify-content:space-between;
      align-items:center;
      gap:12px;
      margin-bottom:8px;
      flex-wrap:wrap;
    }

    .msg-badges{
      display:flex;
      gap:8px;
      flex-wrap:wrap;
    }

    .msg-badge{
      border:1px solid var(--line);
      background:rgba(255,255,255,.05);
      padding:6px 8px;
      border-radius:999px;
      font-size:11px;
      font-weight:800;
    }

    .support-summary{
      display:grid;
      grid-template-columns:repeat(4,minmax(0,1fr));
      gap:10px;
      margin-bottom:14px;
    }

    .support-kpi{
      border:1px solid var(--line);
      border-radius:16px;
      background:rgba(255,255,255,.03);
      padding:12px;
    }

    .support-kpi .k{
      color:var(--muted);
      font-size:11px;
      text-transform:uppercase;
      letter-spacing:.12em;
      font-weight:800;
    }

    .support-kpi .v{
      font-size:24px;
