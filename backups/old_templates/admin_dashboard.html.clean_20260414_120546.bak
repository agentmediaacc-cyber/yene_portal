  <h3 style="margin-top:0">Admin Data Tools</h3>
  <div style="display:flex;gap:10px;flex-wrap:wrap;margin-bottom:14px">
    <input id="townFilterInput" placeholder="Filter by town / region..." style="padding:10px 12px;border-radius:10px;border:1px solid rgba(255,255,255,.12);background:#0b1220;color:#fff;min-width:280px">
