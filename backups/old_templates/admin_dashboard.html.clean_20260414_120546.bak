        <tr>
          <th style="text-align:left;padding:10px;border-bottom:1px solid rgba(255,255,255,.1)">Name</th>
          <th style="text-align:left;padding:10px;border-bottom:1px solid rgba(255,255,255,.1)">Email</th>
          <th style="text-align:left;padding:10px;border-bottom:1px solid rgba(255,255,255,.1)">Phone</th>
          <th style="text-align:left;padding:10px;border-bottom:1px solid rgba(255,255,255,.1)">Region</th>
        </tr>
      </thead>
      <tbody id="broadcastPreviewBody">
        <tr><td colspan="4" style="padding:10px">No broadcast preview yet.</td></tr>
      </tbody>
    </table>
  </div>
</div>


<script>
async function adminGetJson(url, options = {}){
  const res = await fetch(url, { credentials: 'same-origin', ...options });
  const txt = await res.text();
  try { return JSON.parse(txt); } catch(e) { return { success:false, error: txt }; }
}

function fmtMoney(v){
  return 'N$ ' + Number(v || 0).toFixed(2);
}

async function loadNamibiaRegions(){
  const res = await adminGetJson('/api/admin/namibia_regions');
  const sel = document.getElementById('regionSelect');
  if(!sel) return;
  if(!res.success) return;
  sel.innerHTML = '<option value="">Select Namibia region / town</option>';
  (res.rows || []).forEach(r => {
    const opt = document.createElement('option');
    opt.value = r;
    opt.textContent = r;
    sel.appendChild(opt);
  });
}

function renderRegionDue(rows){
  const body = document.getElementById('regionDueBody');
  if(!body) return;
  body.innerHTML = '';
  if(!rows || rows.length === 0){
    body.innerHTML = '<tr><td colspan="5" style="padding:10px">No agents found for selected region.</td></tr>';
    return;
  }
  rows.forEach(r => {
    const tr = document.createElement('tr');
    tr.innerHTML = `
      <td style="padding:10px;border-bottom:1px solid rgba(255,255,255,.08)">${r.full_name || ''}</td>
      <td style="padding:10px;border-bottom:1px solid rgba(255,255,255,.08)">${r.email || ''}</td>
      <td style="padding:10px;border-bottom:1px solid rgba(255,255,255,.08)">${r.phone || ''}</td>
      <td style="padding:10px;border-bottom:1px solid rgba(255,255,255,.08)">${r.region || ''}</td>
      <td style="padding:10px;border-bottom:1px solid rgba(255,255,255,.08)">${fmtMoney(r.amount_due || 0)}</td>
    `;
    body.appendChild(tr);
  });
}

function renderBroadcastPreview(rows){
  const body = document.getElementById('broadcastPreviewBody');
  if(!body) return;
  body.innerHTML = '';
  if(!rows || rows.length === 0){
    body.innerHTML = '<tr><td colspan="4" style="padding:10px">No recipients for selected region.</td></tr>';
    return;
  }
  rows.forEach(r => {
    const tr = document.createElement('tr');
    tr.innerHTML = `
      <td style="padding:10px;border-bottom:1px solid rgba(255,255,255,.08)">${r.full_name || ''}</td>
      <td style="padding:10px;border-bottom:1px solid rgba(255,255,255,.08)">${r.email || ''}</td>
      <td style="padding:10px;border-bottom:1px solid rgba(255,255,255,.08)">${r.phone || ''}</td>
      <td style="padding:10px;border-bottom:1px solid rgba(255,255,255,.08)">${r.region || ''}</td>
    `;
    body.appendChild(tr);
  });
}

async function loadRegionFinance(){
  const region = (document.getElementById('regionSelect')?.value || '').trim();
  if(!region){
    alert('Select a region first.');
    return;
  }
  const res = await adminGetJson('/api/admin/agent_payment_due?town=' + encodeURIComponent(region));
  if(!res.success){
    alert('Could not load region finance: ' + (res.error || 'Unknown error'));
    return;
  }
  renderRegionDue(res.rows || []);
}

function exportFinanceCsv(){
  window.location.href = '/api/admin/export_finance_summary_csv';
}

function exportDueCsv(){
  const region = (document.getElementById('regionSelect')?.value || '').trim();
  const url = '/api/admin/export_agent_due_csv' + (region ? ('?town=' + encodeURIComponent(region)) : '');
  window.location.href = url;
}

async function broadcastByRegion(){
  const region = (document.getElementById('regionSelect')?.value || '').trim();
  const message = (document.getElementById('regionBroadcastMessage')?.value || '').trim();
  if(!region){
    alert('Select a region first.');
    return;
  }
  if(!message){
    alert('Write a broadcast message first.');
    return;
  }

  const res = await adminGetJson('/api/admin/broadcast_by_region', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ region, message })
  });

  if(!res.success){
    alert('Broadcast failed: ' + (res.error || 'Unknown error'));
    return;
  }

  alert('Broadcast prepared for ' + (res.sent_count || 0) + ' agents in ' + region + '.');
  renderBroadcastPreview(res.rows || []);
}

document.addEventListener('DOMContentLoaded', function(){
  loadNamibiaRegions();
});
</script>

<script id="YENE_ADMIN_APPROVAL_PATCH">
async function adminGetJson(url, options = {}){
  const res = await fetch(url, { credentials: 'same-origin', ...options });
  const txt = await res.text();
  try { return JSON.parse(txt); } catch(e) { return { success:false, error: txt }; }
}

function safeEsc(v){
  return String(v ?? "")
    .replaceAll("&","&amp;")
    .replaceAll("<","&lt;")
    .replaceAll(">","&gt;")
    .replaceAll('"',"&quot;")
    .replaceAll("'","&#039;");
}

function approvalBadge(status){
  const s = String(status || "pending").toLowerCase();
  if (s.includes("approve") || s === "active") return '<span class="admin-badge approved">APPROVED</span>';
  if (s.includes("reject") || s === "blocked") return '<span class="admin-badge rejected">REJECTED</span>';
  return '<span class="admin-badge pending">PENDING</span>';
}

function renderApprovalButtons(type, id, status){
  const s = String(status || "").toLowerCase();
  if (s.includes("approve") || s === "active") {
    return '<div class="admin-actions"><span class="admin-badge approved">APPROVED</span></div>';
  }
  if (s.includes("reject") || s === "blocked") {
    return '<div class="admin-actions"><span class="admin-badge rejected">REJECTED</span></div>';
  }
  return 
    <div class="admin-actions">
      <button class="admin-btn ok" onclick="approveRegistration('\','\')">Approve</button>
      <button class="admin-btn no" onclick="rejectRegistration('\','\')">Reject</button>
    </div>
  ;
}

async function approveRegistration(type, id){
  const url = type === "driver"
    ? "/api/admin/approve_driver/" + encodeURIComponent(id)
    : "/api/admin/approve_client/" + encodeURIComponent(id);

  const res = await adminGetJson(url, { method: "POST" });
  if(res.success){
    alert(type + " approved successfully");
    await loadPendingApprovals().catch(()=>{});
    await loadRegionStats().catch(()=>{});
    if(typeof refreshAll === "function") await refreshAll().catch(()=>{});
  } else {
    alert("Approval failed: " + (res.error || "Unknown error"));
  }
}

async function rejectRegistration(type, id){
  const url = type === "driver"
    ? "/api/admin/reject_driver/" + encodeURIComponent(id)
    : "/api/admin/reject_client/" + encodeURIComponent(id);

  const res = await adminGetJson(url, { method: "POST" });
  if(res.success){
    alert(type + " rejected successfully");
    await loadPendingApprovals().catch(()=>{});
    await loadRegionStats().catch(()=>{});
    if(typeof refreshAll === "function") await refreshAll().catch(()=>{});
  } else {
    alert("Reject failed: " + (res.error || "Unknown error"));
  }
}

async function resetAgentPasswordAdmin(agentId, agentName){
  const p = prompt("Enter new password for " + (agentName || "agent"));
  if (p === null) return;

  const newPassword = String(p || "").trim();
  if (newPassword.length < 6){
    alert("Password must be at least 6 characters");
    return;
  }

  const res = await adminGetJson("/api/admin/reset_agent_password/" + encodeURIComponent(agentId), {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({ new_password: newPassword })
  });

  if(res.success){
    alert("Agent password reset successfully");
  } else {
    alert("Reset failed: " + (res.error || "Unknown error"));
  }
}

async function loadPendingApprovals(){
  const body = document.getElementById("pendingApprovalsBody");
  if(!body) return;

  const driverRes = await adminGetJson("/api/admin/pending_drivers");
  const clientRes = await adminGetJson("/api/admin/pending_clients");

  const drivers = driverRes.success ? (driverRes.rows || []) : [];
  const clients = clientRes.success ? (clientRes.rows || []) : [];
  const rows = [];

  drivers.forEach(d => {
    rows.push(
      <tr>
        <td>Driver</td>
        <td>\</td>
        <td>\</td>
        <td>\</td>
        <td>\</td>
        <td>\</td>
        <td>\</td>
      </tr>
    );
  });

  clients.forEach(c => {
    rows.push(
      <tr>
        <td>Client</td>
        <td>\</td>
        <td>\</td>
        <td>\</td>
        <td>\</td>
        <td>\</td>
        <td>\</td>
      </tr>
    );
  });

  body.innerHTML = rows.length
    ? rows.join("")
    : '<tr><td colspan="7" style="padding:10px">No pending driver or client approvals.</td></tr>';
}

async function loadRegionStats(){
  const body = document.getElementById("regionStatsBody");
  if(!body) return;

  const [agentsRes, driversRes, clientsRes] = await Promise.all([
    adminGetJson("/api/admin/agents"),
    adminGetJson("/api/admin/drivers"),
    adminGetJson("/api/admin/clients")
  ]);

  const agents = agentsRes.success ? (agentsRes.rows || agentsRes.data || []) : [];
  const drivers = driversRes.success ? (driversRes.rows || driversRes.data || []) : [];
  const clients = clientsRes.success ? (clientsRes.rows || clientsRes.data || []) : [];

  const stats = {};

  function regionOf(x){
    return String(x.region || x.town || "Unassigned").trim() || "Unassigned";
  }

  agents.forEach(a => {
    const r = regionOf(a);
    if(!stats[r]) stats[r] = { region:r, agents:0, drivers:0, clients:0 };
    stats[r].agents += 1;
  });

  drivers.forEach(d => {
    const r = regionOf(d);
    if(!stats[r]) stats[r] = { region:r, agents:0, drivers:0, clients:0 };
    stats[r].drivers += 1;
  });

  clients.forEach(c => {
    const r = regionOf(c);
    if(!stats[r]) stats[r] = { region:r, agents:0, drivers:0, clients:0 };
    stats[r].clients += 1;
  });

  const rows = Object.values(stats).sort((a,b)=>a.region.localeCompare(b.region));
  body.innerHTML = rows.length
    ? rows.map(r => 
      <tr>
        <td>\</td>
        <td>\</td>
        <td>\</td>
        <td>\</td>
      </tr>
    ).join("")
    : '<tr><td colspan="4" style="padding:10px">No regional data yet.</td></tr>';
}

window.addEventListener("load", function(){
  setTimeout(() => {
    loadPendingApprovals().catch(()=>{});
    loadRegionStats().catch(()=>{});
  }, 400);
});
</script>
<script id="YENE_ANALYTICS_PATCH">
window.__allAgents = [];
window.__allDrivers = [];
window.__allClients = [];
window.__allWalletRows = [];

function csvEscape(value){
  const v = String(value ?? '');
  if (v.includes(',') || v.includes('"') || v.includes('\n')) {
    return '"' + v.replaceAll('"', '""') + '"';
  }
  return v;
}

function exportTableToCSV(tableId, filename){
  const table = document.getElementById(tableId);
  if(!table){ alert('Table not found'); return; }
  const rows = [...table.querySelectorAll('tr')];
  const csv = rows.map(row => {
    const cols = [...row.querySelectorAll('th,td')];
    return cols.map(c => csvEscape(c.innerText.trim())).join(',');
  }).join('\n');

  const blob = new Blob([csv], { type:'text/csv;charset=utf-8;' });
  const link = document.createElement('a');
  link.href = URL.createObjectURL(blob);
  link.download = filename || 'export.csv';
  document.body.appendChild(link);
  link.click();
  link.remove();
}

function pickRegion(x){
  return String(x?.region || x?.town || 'Unassigned').trim() || 'Unassigned';
}

function money(n){
  const v = Number(n || 0);
  return 'N$ ' + v.toFixed(2);
}

async function fetchAdminRows(url){
  const res = await fetch(url, { credentials:'same-origin' });
  const txt = await res.text();
  let json = {};
  try { json = JSON.parse(txt); } catch(e) { json = { success:false, error:txt }; }
  if(!json.success) return [];
  return json.rows || json.data || [];
}

async function loadAnalyticsBase(){
  const [agents, drivers, clients, wallet] = await Promise.all([
    fetchAdminRows('/api/admin/agents'),
    fetchAdminRows('/api/admin/drivers'),
    fetchAdminRows('/api/admin/clients'),
    fetchAdminRows('/api/admin/wallet_ledger')
  ]);

  window.__allAgents = Array.isArray(agents) ? agents : [];
  window.__allDrivers = Array.isArray(drivers) ? drivers : [];
  window.__allClients = Array.isArray(clients) ? clients : [];
  window.__allWalletRows = Array.isArray(wallet) ? wallet : [];
}

function approvedOnly(rows){
  return (rows || []).filter(x => {
    const s = String(x.status || '').toLowerCase();
    return s.includes('approve') || s === 'active' || x.admin_approved === true;
  });
}

function buildRegionData(){
  const regionMap = {};
  const approvedDrivers = approvedOnly(window.__allDrivers);
  const approvedClients = approvedOnly(window.__allClients);

  (window.__allAgents || []).forEach(a => {
    const r = pickRegion(a);
    if(!regionMap[r]) regionMap[r] = { region:r, agents:0, approvedDrivers:0, approvedClients:0, wallet:0 };
    regionMap[r].agents += 1;
  });

  approvedDrivers.forEach(d => {
    const r = pickRegion(d);
    if(!regionMap[r]) regionMap[r] = { region:r, agents:0, approvedDrivers:0, approvedClients:0, wallet:0 };
    regionMap[r].approvedDrivers += 1;
  });

  approvedClients.forEach(c => {
    const r = pickRegion(c);
    if(!regionMap[r]) regionMap[r] = { region:r, agents:0, approvedDrivers:0, approvedClients:0, wallet:0 };
    regionMap[r].approvedClients += 1;
  });

  (window.__allWalletRows || []).forEach(w => {
    const region = String(w.region || '').trim();
    const agentId = String(w.agent_id || '').trim();
    let r = region;

    if(!r && agentId){
      const a = (window.__allAgents || []).find(x => String(x.id || '') === agentId);
      if(a) r = pickRegion(a);
    }
    r = r || 'Unassigned';

    if(!regionMap[r]) regionMap[r] = { region:r, agents:0, approvedDrivers:0, approvedClients:0, wallet:0 };
    regionMap[r].wallet += Number(w.amount || 0);
  });

  return Object.values(regionMap).sort((a,b) => a.region.localeCompare(b.region));
}

async function loadNamibiaRegionCards(){
  if(!window.__allAgents.length && !window.__allDrivers.length && !window.__allClients.length){
    await loadAnalyticsBase();
  }

  const wrap = document.getElementById('namibiaRegionCards');
  const rows = buildRegionData();
  const selected = String(document.getElementById('regionFilterSelect')?.value || '').trim();

  const filtered = selected ? rows.filter(r => String(r.region).toLowerCase() === selected.toLowerCase()) : rows;

  if(!wrap) return;

  wrap.innerHTML = filtered.length ? filtered.map(r => 
    <div class="region-box">
      <div class="r-name">\</div>
      <div class="r-row">Agents: <strong>\</strong></div>
      <div class="r-row">Approved Drivers: <strong>\</strong></div>
      <div class="r-row">Approved Clients: <strong>\</strong></div>
      <div class="r-row">Wallet: <strong>\</strong></div>
    </div>
  ).join('') : '<div class="region-box"><div class="r-name">No data</div><div class="r-row">Nothing found for selected region.</div></div>';

  const body = document.getElementById('regionStatsBody');
  if(body){
    body.innerHTML = filtered.length ? filtered.map(r => 
      <tr>
        <td>\</td>
        <td>\</td>
        <td>\</td>
        <td>\</td>
      </tr>
    ).join('') : '<tr><td colspan="4">No regional stats available.</td></tr>';
  }

  const wBody = document.getElementById('walletRegionBody');
  if(wBody){
    wBody.innerHTML = filtered.length ? filtered.map(r => 
      <tr>
        <td>\</td>
        <td>\</td>
        <td>\</td>
        <td>\</td>
      </tr>
    ).join('') : '<tr><td colspan="4">No wallet report available.</td></tr>';
  }

  const kpi = document.getElementById('walletRegionKpi');
  if(kpi){
    const totalWallet = filtered.reduce((a,b)=>a + Number(b.wallet || 0), 0);
    const topRegion = filtered.slice().sort((a,b)=>b.wallet-a.wallet)[0];
    const totalApprovedDrivers = filtered.reduce((a,b)=>a + Number(b.approvedDrivers || 0), 0);
    const totalApprovedClients = filtered.reduce((a,b)=>a + Number(b.approvedClients || 0), 0);

    kpi.innerHTML = 
      <div class="kpi-box"><div class="k">Total Wallet</div><div class="v">\</div></div>
      <div class="kpi-box"><div class="k">Approved Drivers</div><div class="v">\</div></div>
      <div class="kpi-box"><div class="k">Approved Clients</div><div class="v">\</div></div>
      <div class="kpi-box"><div class="k">Top Region</div><div class="v" style="font-size:18px;">\</div></div>
    ;
  }
}

function buildAgentRankingRows(){
  const agents = window.__allAgents || [];
  const drivers = approvedOnly(window.__allDrivers);
  const clients = approvedOnly(window.__allClients);
  const walletRows = window.__allWalletRows || [];

  const rank = agents.map(a => {
    const id = String(a.id || '');
    const myDrivers = drivers.filter(d => String(d.recruiter_agent_id || '') === id).length;
    const myClients = clients.filter(c => String(c.recruiter_agent_id || '') === id).length;
    const walletTotal = walletRows
      .filter(w => String(w.agent_id || '') === id)
      .reduce((sum,w)=>sum + Number(w.amount || 0), 0);

    const estimatedWallet = walletTotal > 0 ? walletTotal : ((myDrivers * 10) + (myClients * 10));

    return {
      id,
      full_name: a.full_name || a.name || 'Unknown Agent',
      phone: a.phone || '',
      email: a.email || '',
      region: pickRegion(a),
      approvedDrivers: myDrivers,
      approvedClients: myClients,
      estimatedWallet
    };
  });

  rank.sort((a,b) => {
    if (b.estimatedWallet !== a.estimatedWallet) return b.estimatedWallet - a.estimatedWallet;
    if (b.approvedDrivers !== a.approvedDrivers) return b.approvedDrivers - a.approvedDrivers;
    return b.approvedClients - a.approvedClients;
  });

  return rank;
}

function renderAgentRankingWindow(){
  const body = document.getElementById('agentRankingBody');
  if(!body) return;

  const q = String(document.getElementById('rankingSearch')?.value || '').trim().toLowerCase();
  let rows = buildAgentRankingRows();

  if(q){
    rows = rows.filter(a =>
      String(a.full_name).toLowerCase().includes(q) ||
      String(a.phone).toLowerCase().includes(q) ||
      String(a.email).toLowerCase().includes(q) ||
      String(a.region).toLowerCase().includes(q)
    );
  }

  body.innerHTML = rows.length ? rows.map((a, idx) => 
    <tr>
      <td><span class="rank-num">\</span></td>
      <td>
        <div style="font-weight:800;">\</div>
        <div style="color:#9fb2cf;font-size:12px;">\ \</div>
      </td>
      <td>\</td>
      <td>\</td>
      <td>\</td>
      <td>\</td>
      <td>
        <div style="display:flex;gap:8px;flex-wrap:wrap;">
          <button class="admin-btn ghost" onclick="filterRegionFromAgent('\')">View Region</button>
          <button class="admin-btn blue" onclick="resetAgentPasswordAdmin('\','\')">Reset Password</button>
        </div>
      </td>
    </tr>
  ).join('') : '<tr><td colspan="7">No agents found.</td></tr>';
}

function filterRegionFromAgent(region){
  const select = document.getElementById('regionFilterSelect');
  if(select){
    select.value = region || '';
    loadNamibiaRegionCards();
    const top = select.getBoundingClientRect().top + window.scrollY - 80;
    window.scrollTo({ top, behavior:'smooth' });
  }
}

window.addEventListener('load', function(){
  const select = document.getElementById('regionFilterSelect');
  if(select){
    select.addEventListener('change', function(){
      loadNamibiaRegionCards();
    });
  }

  setTimeout(async () => {
    await loadAnalyticsBase().catch(()=>{});
    await loadNamibiaRegionCards().catch(()=>{});
    renderAgentRankingWindow();
  }, 600);
});
</script>
<script id="YENE_AGENT_PROFILE_POWER_PATCH">
window.__superAgents = [];
window.__superDrivers = [];
window.__superClients = [];
window.__selectedAgent = null;

async function superJson(url, options = {}){
  const res = await fetch(url, { credentials:'same-origin', ...options });
  const txt = await res.text();
  try { return JSON.parse(txt); } catch(e) { return { success:false, error:txt }; }
}

function superEsc(v){
  return String(v ?? "")
    .replaceAll("&","&amp;")
    .replaceAll("<","&lt;")
    .replaceAll(">","&gt;")
    .replaceAll('"',"&quot;")
    .replaceAll("'","&#039;");
}

function statusChip(s){
  const v = String(s || '').toUpperCase();
  if(v.includes('ACTIVE') || v.includes('APPROVED')) return '<span class="super-chip active">' + superEsc(v || 'ACTIVE') + '</span>';
  if(v.includes('BLOCK') || v.includes('REJECT')) return '<span class="super-chip blocked">' + superEsc(v || 'BLOCKED') + '</span>';
  return '<span class="super-chip pending">' + superEsc(v || 'PENDING') + '</span>';
}

async function loadAdminSuperData(){
  const [a, d, c] = await Promise.all([
    superJson('/api/admin/agents'),
    superJson('/api/admin/drivers'),
    superJson('/api/admin/clients')
  ]);

  window.__superAgents = a.success ? (a.rows || a.data || []) : [];
  window.__superDrivers = d.success ? (d.rows || d.data || []) : [];
  window.__superClients = c.success ? (c.rows || c.data || []) : [];

  renderAdminAgentPicker();
  if(window.__selectedAgent){
    const fresh = window.__superAgents.find(x => String(x.id) === String(window.__selectedAgent.id));
    if(fresh){
      openAgentProfile(fresh.id);
    }
  }
}

function renderAdminAgentPicker(){
  const body = document.getElementById('adminAgentPickerBody');
  if(!body) return;

  const q = String(document.getElementById('agentSearchInput')?.value || '').trim().toLowerCase();
  const statusFilter = String(document.getElementById('agentStatusFilter')?.value || '').trim().toLowerCase();
  const townFilter = String(document.getElementById('agentTownFilter')?.value || '').trim().toLowerCase();

  let rows = [...(window.__superAgents || [])];

  if(q){
    rows = rows.filter(a =>
      String(a.full_name || '').toLowerCase().includes(q) ||
      String(a.phone || '').toLowerCase().includes(q) ||
      String(a.email || '').toLowerCase().includes(q) ||
      String(a.town || '').toLowerCase().includes(q) ||
      String(a.region || '').toLowerCase().includes(q)
    );
  }

  if(statusFilter){
    rows = rows.filter(a => String(a.status || '').toLowerCase() === statusFilter);
  }

  if(townFilter){
    rows = rows.filter(a =>
      String(a.town || '').toLowerCase().includes(townFilter) ||
      String(a.region || '').toLowerCase().includes(townFilter)
    );
  }

  body.innerHTML = rows.length ? rows.map(a => {
    const agentId = String(a.id || '');
    const myDrivers = (window.__superDrivers || []).filter(d => String(d.recruiter_agent_id || '') === agentId).length;
    const myClients = (window.__superClients || []).filter(c => String(c.recruiter_agent_id || '') === agentId).length;
    return 
      <tr>
        <td><a href="#" onclick="openAgentProfile('');return false;"><strong></strong></a><div style="font-size:12px;color:#94a3b8"></div></td>
        <td></td>
        <td> </td>
        <td></td>
        <td></td>
        <td>
          <div class="super-actions">
            <button class="super-btn blue" onclick="openAgentProfile('')">Open</button>
            <button class="super-btn red" onclick="deleteAgentAdmin('','')">Delete</button>
          </div>
        </td>
      </tr>
    ;
  }).join('') : '<tr><td colspan="6" style="padding:10px">No agents found.</td></tr>';
}

function clearSelectedAgent(){
  window.__selectedAgent = null;
  document.getElementById('selectedAgentWrap').style.display = 'none';
  document.getElementById('selectedAgentEmpty').style.display = 'block';
}

function openAgentProfile(agentId){
  const agent = (window.__superAgents || []).find(a => String(a.id) === String(agentId));
  if(!agent) return;

  window.__selectedAgent = agent;

  document.getElementById('selectedAgentEmpty').style.display = 'none';
  document.getElementById('selectedAgentWrap').style.display = 'block';

  const myDrivers = (window.__superDrivers || []).filter(d => String(d.recruiter_agent_id || '') === String(agent.id));
  const myClients = (window.__superClients || []).filter(c => String(c.recruiter_agent_id || '') === String(agent.id));

  document.getElementById('selectedAgentMeta').innerHTML = 
    <div><strong>Name:</strong> </div>
    <div><strong>Email:</strong> </div>
    <div><strong>Phone:</strong> </div>
    <div><strong>Status:</strong> </div>
    <div><strong>Town:</strong> </div>
    <div><strong>Region:</strong> </div>
    <div><strong>Drivers Registered:</strong> </div>
    <div><strong>Clients Registered:</strong> </div>
    <div class="mono" style="margin-top:8px"><strong>Agent ID:</strong> </div>
  ;

  const clientSelect = document.getElementById('selectedClientTripTarget');
  clientSelect.innerHTML = myClients.length
    ? myClients.map(c => <option value=""> • </option>).join('')
    : '<option value="">No clients</option>';

  const driverSelect = document.getElementById('selectedDriverTripTarget');
  driverSelect.innerHTML = myDrivers.length
    ? myDrivers.map(d => <option value=""> • </option>).join('')
    : '<option value="">No drivers</option>';

  renderSelectedAgentClients(myClients);
  renderSelectedAgentDrivers(myDrivers);
}

function renderSelectedAgentClients(rows){
  const body = document.getElementById('selectedAgentClientsBody');
  if(!body) return;
  body.innerHTML = rows.length ? rows.map(r => 
    <tr>
      <td></td>
      <td></td>
      <td></td>
      <td></td>
      <td><button class="super-btn red" onclick="deleteClientAdmin('','')">Delete</button></td>
    </tr>
  ).join('') : '<tr><td colspan="5">No clients found.</td></tr>';
}

function renderSelectedAgentDrivers(rows){
  const body = document.getElementById('selectedAgentDriversBody');
  if(!body) return;
  body.innerHTML = rows.length ? rows.map(r => 
    <tr>
      <td></td>
      <td></td>
      <td></td>
      <td></td>
      <td><button class="super-btn red" onclick="deleteDriverAdmin('','')">Delete</button></td>
    </tr>
  ).join('') : '<tr><td colspan="5">No drivers found.</td></tr>';
}

async function resetSelectedAgentPassword(){
  if(!window.__selectedAgent) return alert('Select an agent first.');
  const pwd = String(document.getElementById('selectedAgentPassword').value || '').trim();
  if(pwd.length < 6) return alert('Password must be at least 6 characters.');
  const res = await superJson('/api/admin/reset_agent_password/' + encodeURIComponent(window.__selectedAgent.id), {
    method:'POST',
    headers:{ 'Content-Type':'application/json' },
    body: JSON.stringify({ new_password: pwd })
  });
  if(res.success){
    alert('Password reset successful.');
    document.getElementById('selectedAgentPassword').value = '';
  }else{
    alert('Reset failed: ' + (res.error || 'Unknown error'));
  }
}

async function loadFundsToSelectedAgent(){
  if(!window.__selectedAgent) return alert('Select an agent first.');
  const amount = Number(document.getElementById('selectedAgentWalletAmount').value || 0);
  const note = String(document.getElementById('selectedAgentWalletNote').value || '').trim();
  if(amount <= 0) return alert('Enter a valid wallet amount.');
  const res = await superJson('/api/admin/agent_wallet_fund/' + encodeURIComponent(window.__selectedAgent.id), {
    method:'POST',
    headers:{ 'Content-Type':'application/json' },
    body: JSON.stringify({ amount, note })
  });
  if(res.success){
    alert('Funds loaded successfully.');
    document.getElementById('selectedAgentWalletAmount').value = '';
    document.getElementById('selectedAgentWalletNote').value = '';
  }else{
    alert('Load funds failed: ' + (res.error || 'Unknown error'));
  }
}

async function addBonusToSelectedAgent(){
  if(!window.__selectedAgent) return alert('Select an agent first.');
  const amount = Number(document.getElementById('selectedAgentBonusAmount').value || 0);
  const note = String(document.getElementById('selectedAgentBonusNote').value || '').trim();
  if(amount <= 0) return alert('Enter a valid bonus amount.');
  const res = await superJson('/api/admin/agent_wallet_bonus/' + encodeURIComponent(window.__selectedAgent.id), {
    method:'POST',
    headers:{ 'Content-Type':'application/json' },
    body: JSON.stringify({ amount, note })
  });
  if(res.success){
    alert('Bonus added successfully.');
    document.getElementById('selectedAgentBonusAmount').value = '';
    document.getElementById('selectedAgentBonusNote').value = '';
  }else{
    alert('Bonus failed: ' + (res.error || 'Unknown error'));
  }
}

async function updateSelectedClientTrips(){
  if(!window.__selectedAgent) return alert('Select an agent first.');
  const id = String(document.getElementById('selectedClientTripTarget').value || '').trim();
  const trips = Number(document.getElementById('selectedClientTripValue').value || 0);
  if(!id) return alert('Select a client.');
  if(trips < 0) return alert('Trips cannot be negative.');
  const res = await superJson('/api/admin/update_client_trips/' + encodeURIComponent(id), {
    method:'POST',
    headers:{ 'Content-Type':'application/json' },
    body: JSON.stringify({ trips_completed: trips })
  });
  if(res.success){
    alert('Client trips updated.');
    await loadAdminSuperData();
  }else{
    alert('Update failed: ' + (res.error || 'Unknown error'));
  }
}

async function updateSelectedDriverTrips(){
  if(!window.__selectedAgent) return alert('Select an agent first.');
  const id = String(document.getElementById('selectedDriverTripTarget').value || '').trim();
  const trips = Number(document.getElementById('selectedDriverTripValue').value || 0);
  if(!id) return alert('Select a driver.');
  if(trips < 0) return alert('Trips cannot be negative.');
  const res = await superJson('/api/admin/update_driver_trips/' + encodeURIComponent(id), {
    method:'POST',
    headers:{ 'Content-Type':'application/json' },
    body: JSON.stringify({ verified_trips: trips, trips_completed: trips })
  });
  if(res.success){
    alert('Driver trips updated.');
    await loadAdminSuperData();
  }else{
    alert('Update failed: ' + (res.error || 'Unknown error'));
  }
}

window.addEventListener('load', function(){
  setTimeout(() => {
    loadAdminSuperData().catch(()=>{});
  }, 700);
});
</script>

<style id="YENE_MODERN_V3">
  #mobile-menu-btn { display: none; font-size: 28px; cursor: pointer; color: var(--brand); margin-right: 15px; }
  @media(max-width: 900px) {
    #mobile-menu-btn { display: block; }
    .nav#tabs { 
      display: none; flex-direction: column; position: fixed; top: 60px; left: 0; 
      background: #081225; width: 260px; height: 100vh; padding: 20px; z-index: 1000;
      border-right: 1px solid var(--border);
    }
    .nav#tabs.open { display: flex; animation: slideInLeft 0.3s ease; }
  }
  #selectedAgentWrap {
    position: fixed !important; top: 0; right: 0; width: 100%; max-width: 480px; height: 100vh;
    background: #0b1730; border-left: 1px solid var(--brand); z-index: 2000;
    padding: 30px; overflow-y: auto; display: none; box-shadow: -10px 0 30px rgba(0,0,0,0.5);
  }
  .admin-action-btn { 
    padding: 10px; border: none; border-radius: 6px; cursor: pointer; font-weight: bold; margin-top: 10px; width: 100%;
  }
  .btn-delete { background: #ff4d4d; color: white; }
  .btn-fund { background: #25d366; color: white; }
  .filter-bar { display: flex; gap: 10px; margin-bottom: 20px; flex-wrap: wrap; }
  .filter-input { background: #163464; border: 1px solid var(--brand); color: white; padding: 8px; border-radius: 5px; }
</style>

<div id="selectedAgentWrap">
    <button onclick="document.getElementById('selectedAgentWrap').style.display='none'" style="float:right; background:none; border:none; color:white; font-size:20px; cursor:pointer;">✕</button>
    <h2 id="drawName">Agent Profile</h2>
    <div id="drawMeta" style="margin-bottom:20px; font-size:14px; color:var(--muted);"></div>
    
    <div style="background:rgba(255,255,255,0.05); padding:15px; border-radius:10px;">
        <h4>Wallet & Funds</h4>
        <input type="number" id="fundAmount" placeholder="Amount (N$)" class="filter-input" style="width:100%">
        <button class="admin-action-btn btn-fund" onclick="adminLoadFunds()">Load Funds to Agent</button>
    </div>

    <div style="margin-top:20px;">
        <h4>Danger Zone</h4>
        <button class="admin-action-btn btn-delete" onclick="adminDeleteAgent()">Delete Agent Account</button>
        <button class="admin-action-btn btn-delete" style="background:#f59e0b" onclick="adminDeleteAgentData('drivers')">Delete All Drivers Registered</button>
        <button class="admin-action-btn btn-delete" style="background:#f59e0b" onclick="adminDeleteAgentData('clients')">Delete All Clients Registered</button>
    </div>

    <div id="agentLiveMap" style="margin-top:20px; height:150px; background:#071126; border-radius:10px; border:1px solid var(--border); display:grid; place-items:center; position:relative;">
        <div style="width:10px; height:10px; background:#25d366; border-radius:50%; box-shadow:0 0 10px #25d366;"></div>
        <span style="font-size:10px; color:var(--brand)">GPS Tracking Active</span>
    </div>
</div>

<script>
// 1. HAMBURGER LOGIC
setTimeout(() => {
    const h = document.querySelector('header .left');
    if(h) {
        const b = document.createElement('div');
        b.id = 'mobile-menu-btn'; b.innerHTML = '☰';
        b.onclick = () => document.getElementById('tabs').classList.toggle('open');
        h.prepend(b);
    }
}, 500);

// 2. FILTERING LOGIC
function applyAgentFilters() {
    const town = document.getElementById('filterTown').value.toLowerCase();
    const rows = document.querySelectorAll('#agentTableBody tr');
    rows.forEach(r => {
        const text = r.innerText.toLowerCase();
        r.style.display = text.includes(town) ? '' : 'none';
    });
}

// 3. ADMIN ACTIONS (DELETE & FUND)
async function adminLoadFunds() {
    const amt = document.getElementById('fundAmount').value;
    const email = document.getElementById('drawMeta').innerText; // Assumes email is in meta
    if(!amt || !confirm('Load N
</html>




 + amt + ' to ' + email + '?')) return;
    const res = await fetch('/api/admin/fund_agent', {
        method:'POST', headers:{'Content-Type':'application/json'},
        body: JSON.stringify({ email: email, amount: amt })
    });
    const d = await res.json();
    alert(d.message || d.error);
}

async function adminDeleteAgent() {
    const email = document.getElementById('drawMeta').innerText;
    if(!confirm('PERMANENTLY DELETE agent ' + email + '? This cannot be undone.')) return;
    const res = await fetch('/api/admin/delete_agent', {
        method:'DELETE', headers:{'Content-Type':'application/json'},
        body: JSON.stringify({ email: email })
    });
    location.reload();
}

// 4. OVERRIDE EXISTING OPEN PROFILE
const oldOpen = window.openAgentProfile;
window.openAgentProfile = function(id) {
    if(oldOpen) oldOpen(id);
    const wrap = document.getElementById('selectedAgentWrap');
    wrap.style.display = 'block';
    // Fill drawer details from the selectedAgentMeta in your original code
    setTimeout(() => {
        document.getElementById('drawMeta').innerText = document.getElementById('selectedAgentMeta').innerText;
    }, 200);
}
</script>
</body>
</html>





