<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>YENE Admin Dashboard</title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <style>
    :root{
      --bg:#081225;
      --panel:#0c1b36;
      --panel2:#0b1730;
      --border:#163464;
      --text:#e9f2ff;
      --muted:#a6c4ff;
      --brand:#67c3ff;
      --ok:#25d366;
      --warn:#ffb020;
      --bad:#ff4d4d;
    }
    *{box-sizing:border-box}
    body{
      margin:0;
      background:linear-gradient(180deg,#071126,#081225);
      color:var(--text);
      font-family:system-ui,-apple-system,Segoe UI,Roboto,Arial,sans-serif;
    }
    a{color:var(--brand);text-decoration:none}
    header{
      position:sticky;top:0;z-index:10;
      display:flex;align-items:center;justify-content:space-between;
      padding:14px 16px;background:rgba(12,27,54,.92);
      backdrop-filter:blur(10px);
      border-bottom:1px solid var(--border);
    }
    .left,.right,.row{display:flex;gap:10px;align-items:center;flex-wrap:wrap}
    .logo{
      width:38px;height:38px;border-radius:12px;
      background:linear-gradient(135deg,#67c3ff,#1f57ff);
      display:grid;place-items:center;font-weight:900;color:#fff;
    }
    .title h1{font-size:14px;margin:0}
    .title p{margin:0;font-size:12px;color:var(--muted)}
    .wrap{max-width:1300px;margin:0 auto;padding:16px}
    .tabs{display:flex;gap:8px;flex-wrap:wrap;margin:10px 0 16px}
    .tab{
      padding:10px 12px;border-radius:999px;border:1px solid var(--border);
      background:rgba(11,23,48,.7);color:var(--text);cursor:pointer;
      font-weight:700;font-size:12px;
    }
    .tab.active{background:rgba(103,195,255,.18);border-color:rgba(103,195,255,.6)}
    .section{display:none}
    .section.active{display:block}
    .grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}
    @media(max-width:1000px){.grid{grid-template-columns:repeat(2,1fr)}}
    @media(max-width:560px){.grid{grid-template-columns:1fr}}
    .card{
      background:linear-gradient(180deg,rgba(12,27,54,.92),rgba(11,23,48,.92));
      border:1px solid var(--border);border-radius:16px;padding:14px;
      box-shadow:0 18px 40px rgba(0,0,0,.25);
      margin-bottom:12px;
    }
    .card h3{margin:0 0 8px;font-size:13px;color:var(--muted);font-weight:800}
    .big{font-size:26px;font-weight:900}
    .small{font-size:12px;color:var(--muted)}
    .btn{
      border:1px solid rgba(103,195,255,.55);
      background:rgba(103,195,255,.18);
      color:var(--text);
      padding:10px 12px;border-radius:12px;cursor:pointer;
      font-weight:800;font-size:12px;
    }
    .btn:hover{filter:brightness(1.08)}
    .btn.ok{border-color:rgba(37,211,102,.55);background:rgba(37,211,102,.14)}
    .btn.bad{border-color:rgba(255,77,77,.55);background:rgba(255,77,77,.14)}
    .btn.ghost{border-color:var(--border);background:rgba(8,18,37,.4)}
    .pill{
      display:inline-flex;gap:8px;align-items:center;padding:6px 10px;
      border-radius:999px;border:1px solid var(--border);
      background:rgba(8,18,37,.6);font-size:12px;color:var(--muted)
    }
    .dot{width:10px;height:10px;border-radius:999px;background:var(--ok)}
    .muted{color:var(--muted)}
    .hr{height:1px;background:rgba(22,52,100,.6);margin:12px 0}
    .table-wrap{overflow:auto;max-height:560px}
    table{
      width:100%;border-collapse:separate;border-spacing:0;
      border:1px solid var(--border);border-radius:14px;overflow:hidden;
      background:rgba(11,23,48,.75)
    }
    th,td{
      padding:10px;border-bottom:1px solid rgba(22,52,100,.55);
      text-align:left;font-size:12px;vertical-align:top
    }
    th{
      font-size:12px;color:var(--muted);
      background:rgba(12,27,54,.85);position:sticky;top:0
    }
    tr:last-child td{border-bottom:none}
    input, textarea{
      width:100%;padding:11px 12px;border-radius:12px;border:1px solid var(--border);
      background:rgba(8,18,37,.65);color:var(--text);outline:none
    }
    textarea{min-height:110px;resize:vertical}
    .toast{
      position:fixed;bottom:16px;left:50%;transform:translateX(-50%);
      background:rgba(8,18,37,.95);border:1px solid var(--border);
      padding:10px 12px;border-radius:14px;display:none;z-index:9999;
      max-width:92vw
    }
  </style>
</head>
<body>
<header>
  <div class="left">
    <div class="logo">Y</div>
    <div class="title">
      <h1>YENE ADMIN</h1>
      <p>Clean Command Center</p>
    </div>
    <span class="pill"><span class="dot"></span><span id="liveText">Live</span></span>
  </div>
  <div class="right">
    <a class="btn ghost" href="/">Home</a>
    <button class="btn ghost" onclick="refreshAll()">Refresh</button>
    <a class="btn bad" href="/logout">Logout</a>
  </div>
</header>

<div class="wrap">
  <div class="tabs" id="tabs">
    <button class="tab active" data-tab="overview">Overview</button>
    <button class="tab" data-tab="agents">Agents</button>
    <button class="tab" data-tab="agent-center">Agent Center</button>
    <button class="tab" data-tab="drivers">Drivers</button>
    <button class="tab" data-tab="clients">Clients</button>
    <button class="tab" data-tab="finance">Finance</button>
    <button class="tab" data-tab="pricing">Pricing</button>
    <button class="tab" data-tab="broadcasts">Broadcasts</button>
    <button class="tab" data-tab="audit">Audit</button>
  </div>

  <section class="section active" id="overview">
    <div class="card">
      <div class="row" style="justify-content:space-between">
        <div>
          <div class="big">Admin Overview</div>
          <div class="muted">Stable dashboard using working endpoints only</div>
        </div>
        <div class="row">
          <button class="btn" onclick="exportCSV('agents')">Export Agents CSV</button>
          <button class="btn" onclick="exportCSV('drivers')">Export Drivers CSV</button>
          <button class="btn" onclick="exportCSV('clients')">Export Clients CSV</button>
          <button class="btn ok" onclick="downloadWeeklyPDF()">Download Weekly PDF</button>
        </div>
      </div>
    </div>

    <div class="grid">
      <div class="card">
        <h3>Agents</h3>
        <div class="big" id="k_agents_total">—</div>
        <div class="small" id="k_agents_meta">—</div>
      </div>
      <div class="card">
        <h3>Drivers Registered</h3>
        <div class="big" id="k_drivers_total">—</div>
        <div class="small">With timestamps + recruiter</div>
      </div>
      <div class="card">
        <h3>Clients Registered</h3>
        <div class="big" id="k_clients_total">—</div>
        <div class="small">With timestamps + recruiter</div>
      </div>
      <div class="card">
        <h3>Total Paid (N$)</h3>
        <div class="big" id="k_total_paid">—</div>
        <div class="small">Ledger totals</div>
      </div>
    </div>

    <div class="card">
      <div class="row" style="justify-content:space-between">
        <div>
          <div class="big" style="font-size:18px">Recent Activity</div>
          <div class="muted">Last 25 registrations across the network</div>
        </div>
      </div>
      <div class="hr"></div>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Time</th>
              <th>Type</th>
              <th>Name</th>
              <th>Phone</th>
              <th>Town</th>
              <th>Agent</th>
            </tr>
          </thead>
          <tbody id="recentActivity">
            <tr><td colspan="6" class="muted">No activity yet</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section" id="agents">
    <div class="card">
      <div class="row" style="justify-content:space-between">
        <div>
          <div class="big">Agents</div>
          <div class="muted">Status and counts</div>
        </div>
        <input id="agentSearch" placeholder="Search agents..." oninput="renderAgents()" style="max-width:320px">
      </div>
      <div class="hr"></div>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Status</th>
              <th>Name</th>
              <th>Email</th>
              <th>Phone</th>
              <th>Drivers</th>
              <th>Clients</th>
              <th>Created</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody id="agentsTable">
            <tr><td colspan="8" class="muted">Loading...</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>


  <section class="section" id="agent-center">
    <div class="card">
      <div class="row" style="justify-content:space-between">
        <div>
          <div class="big">Agent Center</div>
          <div class="muted">Click any agent to see weekly registrations and full details</div>
        </div>
        <div class="row">
          <select id="agentCenterMode">
            <option value="current_week">Current Week</option>
            <option value="previous_week">Previous Week</option>
            <option value="all_time">All Time</option>
            <option value="custom">Custom Range</option>
          </select>
          <input id="agentCenterWeek" type="date">
          <input id="agentCenterFrom" type="date" style="display:none">
          <input id="agentCenterTo" type="date" style="display:none">
          <button class="btn ghost" onclick="loadSelectedAgentCenter()">Load Selected Agent</button>
          <button class="btn ok" onclick="downloadSelectedAgentPDF()">Download Selected Agent PDF</button>
        </div>
      </div>
      <div class="hr"></div>

      <div class="row" style="align-items:flex-start">
        <div style="flex:1;min-width:320px">
          <div class="table-wrap" style="max-height:520px">
            <table>
              <thead>
                <tr>
                  <th>Name</th>
                  <th>Email</th>
                  <th>Status</th>
                  <th>Open</th>
                </tr>
              </thead>
              <tbody id="agentCenterList">
                <tr><td colspan="4" class="muted">Load agents first</td></tr>
              </tbody>
            </table>
          </div>
        </div>

        <div style="flex:1.2;min-width:420px">
          <div class="card" style="margin-bottom:12px">
            <div class="big" style="font-size:18px">Selected Agent</div>
            <div id="selectedAgentMeta" class="muted" style="margin-top:8px">No agent selected</div>
          </div>

          <div class="card" style="margin-bottom:12px">
            <div class="big" style="font-size:18px">Weekly Summary</div>
            <div class="table-wrap">
              <table>
                <thead>
                  <tr>
                    <th>Day</th>
                    <th>Drivers</th>
                    <th>Clients</th>
                  </tr>
                </thead>
                <tbody id="selectedAgentWeekTable">
                  <tr><td colspan="3" class="muted">No weekly data loaded</td></tr>
                </tbody>
              </table>
            </div>
          </div>

          <div class="card">
            <div class="big" style="font-size:18px">Registration Details</div>
            <div class="table-wrap" style="max-height:420px">
              <table>
                <thead>
                  <tr>
                    <th>Time</th>
                    <th>Type</th>
                    <th>Name</th>
                    <th>Phone</th>
                    <th>Town</th>
                    <th>Code</th>
                  </tr>
                </thead>
                <tbody id="selectedAgentRows">
                  <tr><td colspan="6" class="muted">No detailed rows loaded</td></tr>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>


  <section class="section" id="drivers">
    <div class="card">
      <div class="row" style="justify-content:space-between">
        <div>
          <div class="big">Drivers</div>
          <div class="muted">All registered drivers</div>
        </div>
        <input id="driverSearch" placeholder="Search drivers..." oninput="renderDrivers()" style="max-width:320px">
      </div>
      <div class="hr"></div>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Status</th>
              <th>Name</th>
              <th>Phone</th>
              <th>Town</th>
              <th>Recruiter</th>
              <th>Created</th>
            </tr>
          </thead>
          <tbody id="driversTable">
            <tr><td colspan="6" class="muted">Loading...</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section" id="clients">
    <div class="card">
      <div class="row" style="justify-content:space-between">
        <div>
          <div class="big">Clients</div>
          <div class="muted">All registered clients</div>
        </div>
        <input id="clientSearch" placeholder="Search clients..." oninput="renderClients()" style="max-width:320px">
      </div>
      <div class="hr"></div>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Status</th>
              <th>Name</th>
              <th>Phone</th>
              <th>Recruiter</th>
              <th>Created</th>
            </tr>
          </thead>
          <tbody id="clientsTable">
            <tr><td colspan="5" class="muted">Loading...</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section" id="finance">
    <div class="card">
      <div class="row" style="justify-content:space-between">
        <div>
          <div class="big">Finance Ledger</div>
          <div class="muted">Ledger data</div>
        </div>
        <input id="financeSearch" placeholder="Search finance..." oninput="renderFinance()" style="max-width:320px">
      </div>
      <div class="hr"></div>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Time</th>
              <th>Type</th>
              <th>User</th>
              <th>Amount</th>
              <th>Meta</th>
            </tr>
          </thead>
          <tbody id="financeTable">
            <tr><td colspan="5" class="muted">Loading...</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section" id="pricing">
    <div class="card">
      <div class="big">Pricing Rules</div>
      <div class="muted">Create and update payment rules</div>
      <div class="hr"></div>

      <div class="row" style="align-items:flex-start">
        <div style="flex:1;min-width:300px">
          <label class="muted">Region</label>
          <input id="pr_region" placeholder="e.g. Khomas">
          <div style="height:10px"></div>
          <label class="muted">Town</label>
          <input id="pr_town" placeholder="e.g. Windhoek">
          <div style="height:10px"></div>
          <label class="muted">Rule JSON</label>
          <textarea id="pr_json" placeholder='{"driver_reg":10,"client_reg":10,"status":"Active"}'></textarea>
          <div class="row" style="margin-top:10px">
            <button class="btn ok" onclick="savePricingRule()">Save Rule</button>
            <button class="btn ghost" onclick="loadPricingRules()">Reload</button>
          </div>
        </div>

        <div style="flex:1;min-width:320px">
          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th>Region</th>
                  <th>Town</th>
                  <th>Data</th>
                </tr>
              </thead>
              <tbody id="pricingTable">
                <tr><td colspan="3" class="muted">Loading...</td></tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="broadcasts">
    <div class="card">
      <div class="big">Broadcasts</div>
      <div class="muted">Send and edit platform announcements</div>
      <div class="hr"></div>

      <label class="muted">New broadcast message</label>
      <textarea id="bc_new_message" placeholder="Type your message..."></textarea>
      <div class="row" style="margin-top:10px">
        <button class="btn ok" onclick="createBroadcast()">Send Broadcast</button>
        <button class="btn ghost" onclick="loadBroadcasts()">Reload</button>
      </div>

      <div class="hr"></div>

      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Created</th>
              <th>Message</th>
              <th>Target</th>
              <th>ID</th>
            </tr>
          </thead>
          <tbody id="broadcastsTable">
            <tr><td colspan="4" class="muted">Loading...</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section" id="audit">
    <div class="card">
      <div class="row" style="justify-content:space-between">
        <div>
          <div class="big">Audit Logs</div>
          <div class="muted">Recent system activity</div>
        </div>
        <button class="btn ghost" onclick="loadAudit()">Reload</button>
      </div>
      <div class="hr"></div>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Time</th>
              <th>Event</th>
              <th>Description</th>
              <th>User</th>
              <th>IP</th>
            </tr>
          </thead>
          <tbody id="auditTable">
            <tr><td colspan="5" class="muted">Loading...</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>
</div>

<div class="toast" id="toast"></div>

<script>
let agents = [];
let agentCounts = {};
let drivers = [];
let clients = [];
let finance = [];
let pricingRules = [];
let broadcasts = [];
let selectedAgentId = null;
let selectedAgentWeekData = null;

function toast(msg){
  const el = document.getElementById("toast");
  el.textContent = msg;
  el.style.display = "block";
  setTimeout(()=> el.style.display = "none", 2500);
}
function esc(s){
  return String(s || "").replaceAll("&","&amp;").replaceAll("<","&lt;").replaceAll(">","&gt;");
}
function safe(v, fallback="—"){
  return (v === null || v === undefined || v === "") ? fallback : v;
}
function fmtDate(x){
  if(!x) return "—";
  try { return new Date(x).toLocaleString(); } catch(e){ return String(x); }
}
function fmtMoney(n){
  let num = Number(n || 0);
  if (Number.isNaN(num)) num = 0;
  return "N$ " + num.toFixed(2);
}

async function apiGET(url){
  const r = await fetch(url, {credentials:"same-origin"});
  const j = await r.json().catch(()=> ({}));
  if(!r.ok || j.success === false){
    throw new Error(j.error || ("Request failed: " + r.status));
  }
  return j;
}

async function apiJSON(url, method, body){
  const r = await fetch(url, {
    method,
    credentials:"same-origin",
    headers: {"Content-Type":"application/json"},
    body: JSON.stringify(body || {})
  });
  const j = await r.json().catch(()=> ({}));
  if(!r.ok || j.success === false){
    throw new Error(j.error || ("Request failed: " + r.status));
  }
  return j;
}

document.getElementById("tabs").addEventListener("click", (e)=>{
  const btn = e.target.closest(".tab");
  if(!btn) return;
  document.querySelectorAll(".tab").forEach(t=>t.classList.remove("active"));
  btn.classList.add("active");
  document.querySelectorAll(".section").forEach(s=>s.classList.remove("active"));
  document.getElementById(btn.dataset.tab).classList.add("active");
  if (btn.dataset.tab === "agent-center") {
    loadAgentCenterListDirect();
  }
});

async function loadOverview(){
  const j = await apiGET("/api/admin/overview");
  const d = j.data || {};
  document.getElementById("k_agents_total").textContent = safe(d.agents_total, "0");
  document.getElementById("k_agents_meta").textContent =
    `Active ${safe(d.agents_active,0)} • Pending ${safe(d.agents_pending,0)} • Blocked ${safe(d.agents_blocked,0)}`;
  document.getElementById("k_drivers_total").textContent = safe(d.drivers_total, "0");
  document.getElementById("k_clients_total").textContent = safe(d.clients_total, "0");
  document.getElementById("k_total_paid").textContent = fmtMoney(d.total_paid);

  const body = document.getElementById("recentActivity");
  const rows = d.recent_activity || [];
  body.innerHTML = rows.length ? rows.map(r => `
    <tr>
      <td>${esc(fmtDate(r.created_at))}</td>
      <td>${esc(safe(r.type))}</td>
      <td>${esc(safe(r.name))}</td>
      <td>${esc(safe(r.phone))}</td>
      <td>${esc(safe(r.town))}</td>
      <td>${esc(safe(r.agent))}</td>
    </tr>
  `).join("") : `<tr><td colspan="6" class="muted">No activity yet</td></tr>`;
}

async function loadAgents(){
  const j = await apiGET("/api/admin/agents");
  console.log("AGENTS API RESPONSE", j);

  agents = Array.isArray(j?.rows) ? j.rows : [];
  agentCounts = {};

  for (const a of agents) {
    if (a && a.id) {
      agentCounts[a.id] = {
        drivers: Number(a.drivers || 0),
        clients: Number(a.clients || 0)
      };
    }
  }

  renderAgents();
  renderAgentCenterList();
}

async function loadDrivers(){
  const j = await apiGET("/api/admin/drivers");
  drivers = j.data || [];
  renderDrivers();
}

async function loadClients(){
  const j = await apiGET("/api/admin/clients");
  clients = j.data || [];
  renderClients();
}

async function loadFinance(){
  const j = await apiGET("/api/admin/finance");
  finance = j.data || [];
  renderFinance();
}

async function loadPricingRules(){
  const j = await apiGET("/api/admin/payment_rules");
  pricingRules = j.data || [];
  renderPricing();
}

async function loadBroadcasts(){
  const j = await apiGET("/api/admin/broadcasts");
  broadcasts = j.data || [];
  renderBroadcasts();
}

async function loadAudit(){
  const j = await apiGET("/api/admin/audit_logs");
  const logs = j.data || [];
  const tb = document.getElementById("auditTable");
  tb.innerHTML = logs.length ? logs.map(x => `
    <tr>
      <td>${esc(fmtDate(x.created_at))}</td>
      <td>${esc(safe(x.event_type))}</td>
      <td>${esc(safe(x.description))}</td>
      <td>${esc(safe(x.user_id))}</td>
      <td>${esc(safe(x.ip_address))}</td>
    </tr>
  `).join("") : `<tr><td colspan="5" class="muted">No logs</td></tr>`;
}

function renderAgents(){
  const q = (document.getElementById("agentSearch").value || "").toLowerCase().trim();
  const list = agents.filter(a => {
    if(!q) return true;
    const hay = `${a.full_name||""} ${a.email||""} ${a.phone||a.phone_number||""}`.toLowerCase();
    return hay.includes(q);
  });

  const tb = document.getElementById("agentsTable");
  tb.innerHTML = list.length ? list.map(a => {
    const c = agentCounts[a.id] || {drivers:0, clients:0};
    return `
      <tr>
        <td>${esc(safe(a.status))}</td>
        <td>${esc(safe(a.full_name))}</td>
        <td>${esc(safe(a.email))}</td>
        <td>${esc(safe(a.phone || a.phone_number))}</td>
        <td>${esc(c.drivers || 0)}</td>
        <td>${esc(c.clients || 0)}</td>
        <td>${esc(fmtDate(a.created_at))}</td>
        <td class="row">
          <button class="btn ok" onclick="setAgentStatus('${a.id}','ACTIVE')">Activate</button>
          <button class="btn bad" onclick="setAgentStatus('${a.id}','BLOCKED')">Block</button>
        </td>
      </tr>
    `;
  }).join("") : `<tr><td colspan="8" class="muted">No agents found</td></tr>`;
}

function renderDrivers(){
  const q = (document.getElementById("driverSearch").value || "").toLowerCase().trim();
  const list = drivers.filter(d => {
    if(!q) return true;
    const hay = `${d.full_name||""} ${d.phone||d.phone_number||""} ${d.town||""} ${d.recruiter_name||""}`.toLowerCase();
    return hay.includes(q);
  });

  const tb = document.getElementById("driversTable");
  tb.innerHTML = list.length ? list.map(d => `
    <tr>
      <td>${esc(safe(d.status))}</td>
      <td>${esc(safe(d.full_name))}</td>
      <td>${esc(safe(d.phone || d.phone_number))}</td>
      <td>${esc(safe(d.town))}</td>
      <td>${esc(safe(d.recruiter_name))}</td>
      <td>${esc(fmtDate(d.created_at))}</td>
    </tr>
  `).join("") : `<tr><td colspan="6" class="muted">No drivers found</td></tr>`;
}

function renderClients(){
  const q = (document.getElementById("clientSearch").value || "").toLowerCase().trim();
  const list = clients.filter(c => {
    if(!q) return true;
    const hay = `${c.full_name||""} ${c.phone||c.phone_number||""} ${c.recruiter_name||""}`.toLowerCase();
    return hay.includes(q);
  });

  const tb = document.getElementById("clientsTable");
  tb.innerHTML = list.length ? list.map(c => `
    <tr>
      <td>${esc(safe(c.status))}</td>
      <td>${esc(safe(c.full_name))}</td>
      <td>${esc(safe(c.phone || c.phone_number))}</td>
      <td>${esc(safe(c.recruiter_name))}</td>
      <td>${esc(fmtDate(c.created_at))}</td>
    </tr>
  `).join("") : `<tr><td colspan="5" class="muted">No clients found</td></tr>`;
}

function renderFinance(){
  const q = (document.getElementById("financeSearch").value || "").toLowerCase().trim();
  const list = finance.filter(x => !q || JSON.stringify(x || {}).toLowerCase().includes(q));
  const tb = document.getElementById("financeTable");
  tb.innerHTML = list.length ? list.map(x => `
    <tr>
      <td>${esc(fmtDate(x.created_at))}</td>
      <td>${esc(safe(x.type || x.event_type || x.category))}</td>
      <td>${esc(safe(x.user_id || x.email || x.actor))}</td>
      <td>${esc(fmtMoney(x.amount))}</td>
      <td>${esc(JSON.stringify(x.meta || x.details || {}))}</td>
    </tr>
  `).join("") : `<tr><td colspan="5" class="muted">No finance data</td></tr>`;
}

function renderPricing(){
  const tb = document.getElementById("pricingTable");
  tb.innerHTML = pricingRules.length ? pricingRules.map(r => `
    <tr onclick='loadRuleToEditor(${JSON.stringify(r)})' style="cursor:pointer">
      <td>${esc(r.region || "")}</td>
      <td>${esc(r.town || "")}</td>
      <td>${esc(JSON.stringify(r))}</td>
    </tr>
  `).join("") : `<tr><td colspan="3" class="muted">No pricing rules</td></tr>`;
}

function renderBroadcasts(){
  const tb = document.getElementById("broadcastsTable");
  tb.innerHTML = broadcasts.length ? broadcasts.map(bc => `
    <tr>
      <td>${esc(fmtDate(bc.created_at))}</td>
      <td>${esc(safe(bc.message))}</td>
      <td>${esc(safe(bc.target_region || "ALL"))}</td>
      <td>${esc(safe(bc.id))}</td>
    </tr>
  `).join("") : `<tr><td colspan="4" class="muted">No broadcasts</td></tr>`;
}

async function setAgentStatus(agentId, status){
  try{
    await apiJSON("/api/admin/approve_agent", "POST", {agent_id: agentId, status});
    toast("Agent updated");
    await loadAgents();
    renderAgentCenterList();
    renderAgentCenterList();
    await loadAgentCenterListDirect();
    initAgentCenterWeek();
    bindAgentCenterControls();
    await loadOverview();
  }catch(e){
    toast(e.message);
  }
}

async function savePricingRule(){
  const region = (document.getElementById("pr_region").value || "").trim();
  const town = (document.getElementById("pr_town").value || "").trim();
  const raw = (document.getElementById("pr_json").value || "").trim();

  if(!region || !town){
    toast("Region and town are required");
    return;
  }

  let payload = {};
  if(raw){
    try{ payload = JSON.parse(raw); }
    catch(e){ toast("Invalid rule JSON"); return; }
  }

  payload.region = region;
  payload.town = town;

  try{
    await apiJSON("/api/admin/payment_rules", "POST", payload);
    toast("Pricing rule saved");
    await loadPricingRules();
  }catch(e){
    toast(e.message);
  }
}

function loadRuleToEditor(rule){
  document.getElementById("pr_region").value = rule.region || "";
  document.getElementById("pr_town").value = rule.town || "";
  const clone = {...rule};
  delete clone.id;
  document.getElementById("pr_json").value = JSON.stringify(clone, null, 2);
}

async function createBroadcast(){
  const message = (document.getElementById("bc_new_message").value || "").trim();
  if(!message){
    toast("Message required");
    return;
  }
  try{
    await apiJSON("/api/admin/broadcast", "POST", {message});
    document.getElementById("bc_new_message").value = "";
    toast("Broadcast sent");
    await loadBroadcasts();
  }catch(e){
    toast(e.message);
  }
}

function exportCSV(type){
  let rows = [];
  if(type === "agents") rows = agents;
  if(type === "drivers") rows = drivers;
  if(type === "clients") rows = clients;
  if(!rows.length){ toast("Nothing loaded yet"); return; }

  const cols = Object.keys(rows[0] || {});
  const csv = [
    cols.join(","),
    ...rows.map(r => cols.map(c => {
      const v = r[c];
      const s = (v === null || v === undefined) ? "" : (typeof v === "object" ? JSON.stringify(v) : String(v));
      return `"${s.replaceAll('"','""')}"`;
    }).join(","))
  ].join("\\n");

  const blob = new Blob([csv], {type:"text/csv;charset=utf-8"});
  const a = document.createElement("a");
  a.href = URL.createObjectURL(blob);
  a.download = `yene_${type}_${new Date().toISOString().slice(0,10)}.csv`;
  document.body.appendChild(a);
  a.click();
  a.remove();
}

function downloadWeeklyPDF(){
  const today = new Date();
  const day = today.getDay();
  const diff = (day === 0 ? -6 : 1 - day);
  const monday = new Date(today);
  monday.setDate(today.getDate() + diff);
  const weekStart = monday.toISOString().slice(0,10);
  window.location.href = `/api/admin/weekly_agent_report_pdf?week_start=${weekStart}`;
}




function maybeAutoLoadAgentCenter(){
  if (!selectedAgentId) return;

  const mode = document.getElementById("agentCenterMode")?.value || "current_week";
  const week = document.getElementById("agentCenterWeek")?.value || "";
  const from = document.getElementById("agentCenterFrom")?.value || "";
  const to = document.getElementById("agentCenterTo")?.value || "";

  if (mode === "custom") {
    if (from && to) {
      loadSelectedAgentCenter();
    }
    return;
  }

  if (mode === "all_time") {
    loadSelectedAgentCenter();
    return;
  }

  if (week) {
    loadSelectedAgentCenter();
  }
}

function toggleAgentCenterDateInputs(){
  const mode = document.getElementById("agentCenterMode")?.value || "current_week";
  const week = document.getElementById("agentCenterWeek");
  const from = document.getElementById("agentCenterFrom");
  const to = document.getElementById("agentCenterTo");

  if (!week || !from || !to) return;

  if (mode === "custom") {
    week.style.display = "none";
    from.style.display = "";
    to.style.display = "";
  } else if (mode === "all_time") {
    week.style.display = "none";
    from.style.display = "none";
    to.style.display = "none";
  } else {
    week.style.display = "";
    from.style.display = "none";
    to.style.display = "none";
  }
}


function bindAgentCenterControls(){
  const mode = document.getElementById("agentCenterMode");
  const week = document.getElementById("agentCenterWeek");
  const from = document.getElementById("agentCenterFrom");
  const to = document.getElementById("agentCenterTo");

  if (mode && !mode.dataset.bound) {
    mode.addEventListener("change", () => {
      toggleAgentCenterDateInputs();
  bindAgentCenterControls();
      maybeAutoLoadAgentCenter();
    });
    mode.dataset.bound = "1";
  }

  const bindDate = (el) => {
    if (!el || el.dataset.bound) return;
    el.addEventListener("change", () => {
      maybeAutoLoadAgentCenter();
    });
    el.addEventListener("keydown", (event) => {
      if (event.key === "Enter") {
        event.preventDefault();
        maybeAutoLoadAgentCenter();
      }
    });
    el.dataset.bound = "1";
  };

  bindDate(week);
  bindDate(from);
  bindDate(to);
}

function initAgentCenterWeek(){
  const el = document.getElementById("agentCenterWeek");
  const from = document.getElementById("agentCenterFrom");
  const to = document.getElementById("agentCenterTo");
  if(!el) return;

  const today = new Date();
  const day = today.getDay();
  const diff = (day === 0 ? -6 : 1 - day);
  const monday = new Date(today);
  monday.setDate(today.getDate() + diff);

  el.value = monday.toISOString().slice(0,10);
  if (from) from.value = monday.toISOString().slice(0,10);

  const sunday = new Date(monday);
  sunday.setDate(monday.getDate() + 6);
  if (to) to.value = sunday.toISOString().slice(0,10);

  toggleAgentCenterDateInputs();
  bindAgentCenterControls();
}

function renderAgentCenterList(){
  const body = document.getElementById("agentCenterList");
  if(!body) return;

  console.log("RENDER AGENT CENTER", agents.length, agents);

  if (!agents || !agents.length) {
    body.innerHTML = `<tr><td colspan="4" class="muted">No agents found</td></tr>`;
    return;
  }

  body.innerHTML = agents.map(a => `
    <tr>
      <td>${esc(safe(a.full_name || a.username || a.name || "-"))}</td>
      <td>${esc(safe(a.email || "-"))}</td>
      <td>${esc(safe(a.status || "-"))}</td>
      <td><button class="btn" onclick="openAgentCenter('${a.id}')">Open</button></td>
    </tr>
  `).join("");
}

function openAgentCenter(agentId){
  selectedAgentId = agentId;
  document.querySelectorAll(".tab").forEach(t=>t.classList.remove("active"));
  document.querySelector('.tab[data-tab="agent-center"]').classList.add("active");
  document.querySelectorAll(".section").forEach(s=>s.classList.remove("active"));
  document.getElementById("agent-center").classList.add("active");
  maybeAutoLoadAgentCenter();
}

async function loadSelectedAgentCenter(){
  if(!selectedAgentId){
    toast("Select an agent first");
    return;
  }
  const mode = document.getElementById("agentCenterMode")?.value || "current_week";
  const weekStart = document.getElementById("agentCenterWeek")?.value || "";
  const dateFrom = document.getElementById("agentCenterFrom")?.value || "";
  const dateTo = document.getElementById("agentCenterTo")?.value || "";

  let qs = `mode=${encodeURIComponent(mode)}`;
  if (mode === "custom") {
    qs += `&date_from=${encodeURIComponent(dateFrom)}&date_to=${encodeURIComponent(dateTo)}`;
  } else if (mode !== "all_time") {
    qs += `&week_start=${encodeURIComponent(weekStart)}`;
  }

  const j = await apiGET(`/api/admin/agent_center/${encodeURIComponent(selectedAgentId)}?${qs}`);
  const d = j.data || {};
  selectedAgentWeekData = d;

  const a = d.agent || {};
  document.getElementById("selectedAgentMeta").innerHTML =
    `<b>${esc(safe(a.full_name))}</b><br>` +
    `Email: ${esc(safe(a.email))}<br>` +
    `Phone: ${esc(safe(a.phone))}<br>` +
    `Town: ${esc(safe(a.town))} | Region: ${esc(safe(a.region))}<br>` +
    `Status: ${esc(safe(a.status))}<br>` +
    `Mode: ${esc(safe(d.mode || "current_week"))}<br>` +
    `Period: ${d.date_from ? esc(safe(d.date_from)) : "All Time"} ${d.date_to ? "to " + esc(safe(d.date_to)) : ""}<br>` +
    `Drivers Total: ${esc(safe(d.drivers_total,0))} | Clients Total: ${esc(safe(d.clients_total,0))}`;

  const weekBody = document.getElementById("selectedAgentWeekTable");
  const days = d.days || {};
  const order = ["Mon","Tue","Wed","Thu","Fri","Sat","Sun"];
  weekBody.innerHTML = order.map(day => `
    <tr>
      <td>${day}</td>
      <td>${esc(safe(days[day]?.drivers,0))}</td>
      <td>${esc(safe(days[day]?.clients,0))}</td>
    </tr>
  `).join("");

  const rowsBody = document.getElementById("selectedAgentRows");
  const rows = d.rows || [];
  rowsBody.innerHTML = rows.length ? rows.map(r => `
    <tr>
      <td>${esc(fmtDate(r.created_at))}</td>
      <td>${esc(safe(r.type))}</td>
      <td>${esc(safe(r.name))}</td>
      <td>${esc(safe(r.phone))}</td>
      <td>${esc(safe(r.town))}</td>
      <td>${esc(safe(r.code))}</td>
    </tr>
  `).join("") : `<tr><td colspan="6" class="muted">No weekly rows for this agent</td></tr>`;
}

function downloadSelectedAgentPDF(){
  if(!selectedAgentId){
    toast("Select an agent first");
    return;
  }
  const mode = document.getElementById("agentCenterMode")?.value || "current_week";
  const weekStart = document.getElementById("agentCenterWeek")?.value || "";
  const dateFrom = document.getElementById("agentCenterFrom")?.value || "";
  const dateTo = document.getElementById("agentCenterTo")?.value || "";

  let qs = `mode=${encodeURIComponent(mode)}`;
  if (mode === "custom") {
    qs += `&date_from=${encodeURIComponent(dateFrom)}&date_to=${encodeURIComponent(dateTo)}`;
  } else if (mode !== "all_time") {
    qs += `&week_start=${encodeURIComponent(weekStart)}`;
  }

  window.location.href = `/api/admin/agent_center_pdf/${encodeURIComponent(selectedAgentId)}?${qs}`;
}


async function loadAgentCenterListDirect(){
  const body = document.getElementById("agentCenterList");
  if(!body) return;

  body.innerHTML = `<tr><td colspan="4" class="muted">Loading agents...</td></tr>`;

  try{
    const j = await apiGET("/api/admin/agents");
    const rows = Array.isArray(j?.rows) ? j.rows : [];

    body.innerHTML = rows.length ? rows.map(a => `
      <tr>
        <td>${esc(safe(a.full_name || a.username || a.name || "-"))}</td>
        <td>${esc(safe(a.email || "-"))}</td>
        <td>${esc(safe(a.status || "-"))}</td>
        <td><button class="btn" onclick="openAgentCenter('${a.id}')">Open</button></td>
      </tr>
    `).join("") : `<tr><td colspan="4" class="muted">No agents found</td></tr>`;
  }catch(e){
    body.innerHTML = `<tr><td colspan="4" class="muted">Failed to load agents</td></tr>`;
    console.error("Agent Center list error:", e);
  }
}

async function refreshAll(){
  try{
    await loadOverview();
    await loadAgents();
    renderAgentCenterList();
    renderAgentCenterList();
    await loadAgentCenterListDirect();
    initAgentCenterWeek();
    bindAgentCenterControls();
    await loadDrivers();
    await loadClients();
    await loadFinance();
    await loadPricingRules();
    await loadBroadcasts();
    await loadAudit();
    toast("Refreshed");
  }catch(e){
    toast(e.message);
  }
}

refreshAll();
</script>
</body>
</html>
